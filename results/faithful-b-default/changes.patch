+test("catalog filters the full newest-first catalog before paginating matching debates", async (t) => {
+  const root = await fixture(t);
+  const fixtures = [
+    ["debate-06", "STATUS: RESOLVED", true],
+    ["debate-05", "STATUS: NEEDS_INPUT", false],
+    ["debate-04", "STATUS: RESOLVED", false],
+    ["debate-03", "Respondeo turn failed: timeout", true],
+    ["debate-02", "malformed", false],
+    ["debate-01", null, false],
+  ] as const;
+  for (const [id, determination, report] of fixtures) {
+    const path = join(root, id);
+    await mkdir(path);
+    if (determination !== null) await writeFile(join(path, "respondeo.md"), determination);
+    if (report) await writeFile(join(path, "final-report.md"), "report");
+  }
+  const all = await listDebates(root);
+  assert.deepEqual(all.map((entry) => entry.id), fixtures.map(([id]) => id));
+  assert.deepEqual(await listDebates(root, { status: undefined, hasFinalReport: undefined }), all);
+  for (const [status, indexes] of [
+    ["resolved", [0, 2]], ["needs-input", [1]], ["failed", [3]],
+    ["unknown", [4]], ["unjudged", [5]],
+  ] as const) {
+    assert.deepEqual(await listDebates(root, { status }), indexes.map((index) => all[index]));
+  }
+  assert.deepEqual(await listDebates(root, { hasFinalReport: true }), [all[0], all[3]]);
+  assert.deepEqual(await listDebates(root, { hasFinalReport: false }), [all[1], all[2], all[4], all[5]]);
+  assert.deepEqual(await listDebates(root, { status: "resolved", hasFinalReport: false }), [all[2]]);
+  assert.deepEqual(await listDebates(root, { status: "needs-input", hasFinalReport: true }), []);
+
+  // Nonmatching debates consume neither the offset nor the limit.
+  assert.deepEqual(await listDebates(root, { limit: 2, status: "resolved" }), [all[0], all[2]]);
+  assert.deepEqual(await listDebates(root, { limit: 2, hasFinalReport: true }), [all[0], all[3]]);
+  assert.deepEqual(await listDebates(root, { offset: 1, limit: 1, status: "resolved" }), [all[2]]);
+  assert.deepEqual(await listDebates(root, { offset: 1, limit: 1, hasFinalReport: true }), [all[3]]);
+  assert.deepEqual(await listDebates(root, { offset: 1, limit: 2, hasFinalReport: false }), [all[2], all[4]]);
+  assert.deepEqual(await listDebates(root, { offset: 1, limit: 3, status: "resolved" }), [all[2]]);
+  assert.deepEqual(await listDebates(root, { offset: 1, limit: 3, hasFinalReport: true }), [all[3]]);
+  assert.deepEqual(await listDebates(root, { limit: 1, status: "resolved", hasFinalReport: false }), [all[2]]);
+  assert.deepEqual(await listDebates(root, { offset: 1, limit: 3, status: "resolved", hasFinalReport: false }), []);
+  assert.deepEqual(await listDebates(root, { limit: 1, status: "unjudged" }), [all[5]]);
+  assert.deepEqual(await listDebates(root, { offset: 1, status: "resolved" }), [all[2]]);
+  assert.deepEqual(await listDebates(root, { offset: 2, status: "resolved" }), []);
+  assert.deepEqual(await listDebates(root, { offset: 1, hasFinalReport: false }), [all[2], all[4], all[5]]);
+  assert.deepEqual(await listDebates(root, { limit: 0, status: "resolved", hasFinalReport: true }), []);
+  assert.deepEqual(await listDebates(root, { offset: 6, hasFinalReport: false }), []);
+  assert.deepEqual(await listDebates(root, { offset: 1, limit: 2, status: undefined, hasFinalReport: undefined }), [all[1], all[2]]);
+});
