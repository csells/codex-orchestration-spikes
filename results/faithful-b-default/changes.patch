+test("catalog selects the numerically highest positive determination version", async (t) => {
+  const root = await fixture(t);
+  const path = join(root, "debate-versions");
+  await mkdir(path);
+  const metadata = async () => {
+    const [entry] = await listDebates(root);
+    return { determination: entry.determination, status: entry.status };
+  };
+  await writeFile(join(path, "respondeo.md"), "STATUS: RESOLVED");
+  assert.deepEqual(await metadata(), { determination: "respondeo.md", status: "resolved" });
+  await writeFile(join(path, "respondeo-2.md"), "STATUS: NEEDS_INPUT");
+  await writeFile(join(path, "respondeo-10.md"), "Respondeo turn failed: timeout");
+  assert.deepEqual(await metadata(), { determination: "respondeo-10.md", status: "failed" });
+  // Leading zeros still denote a positive integer; malformed suffixes do not.
+  await writeFile(join(path, "respondeo-011.md"), "malformed\nSTATUS: RESOLVED");
+  for (const name of ["respondeo-0.md", "respondeo-000.md", "respondeo--12.md", "respondeo-12.5.md", "respondeo-1e9.md", "respondeo-+12.md", "respondeo-12.md.bak", "respondeo-12.md\n"]) {
+    await writeFile(join(path, name), "STATUS: RESOLVED");
+  }
+  assert.deepEqual(await metadata(), { determination: "respondeo-011.md", status: "unknown" });
+  await writeFile(join(path, "respondeo-9007199254740992.md"), "STATUS: RESOLVED");
+  await writeFile(join(path, "respondeo-9007199254740993.md"), "STATUS: NEEDS_INPUT");
+  assert.deepEqual(await metadata(), { determination: "respondeo-9007199254740993.md", status: "needs-input" });
+});
