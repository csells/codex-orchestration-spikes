+import { constants } from "node:fs";
+import { lstat, open, readdir } from "node:fs/promises";
+import { join, resolve } from "node:path";
+
+export type DeterminationStatus = "resolved" | "needs-input" | "failed" | "unknown";
+export type DebateArtifactKind = "transcript" | "determination" | "final-report";
+
+export type DebateEntry = {
+  id: string;
+  path: string;
+  hasTranscript: boolean;
+  hasFinalReport: boolean;
+  determination: string | null;
+  status: "unjudged" | DeterminationStatus;
+};
+
+export type ListDebatesOptions = {
+  offset?: number;
+  limit?: number;
+  /** Filters apply to the full newest-first catalog before offset and limit. */
+  status?: DebateEntry["status"];
+  hasFinalReport?: boolean;
+};
+
+const DEBATE_ID = /^debate-[A-Za-z0-9][A-Za-z0-9._-]*$/;
+const CATALOG_STATUSES = new Set<DebateEntry["status"]>(["unjudged", "resolved", "needs-input", "failed", "unknown"]);
+
+function isDebateId(id: string): boolean {
+  return typeof id === "string" && DEBATE_ID.exec(id)?.[0] === id;
+}
+
+function unsafePath(): Error {
+  return Object.assign(new Error("Refusing to follow a debate directory or artifact symlink"), { code: "UNSAFE_PATH" });
+}
+
+async function readRegularArtifact(path: string): Promise<string | null> {
+  let file;
+  try {
+    const info = await lstat(path);
+    if (info.isSymbolicLink()) throw unsafePath();
+    if (!info.isFile()) return null;
+    // Reject links even if the file changes after lstat; never block on a replacement FIFO.
+    file = await open(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+    if (!(await file.stat()).isFile()) return null;
+    return await file.readFile("utf8");
+  } catch (error) {
+    const code = (error as NodeJS.ErrnoException).code;
+    if (code === "ENOENT") return null;
+    if (code === "ELOOP") throw unsafePath();
+    throw error;
+  } finally {
+    await file?.close();
+  }
+}
+
+/** Catalog classification is deliberately stricter than the debate engine's parser. */
+export function classifyDetermination(text: string): DeterminationStatus {
+  const first = text.split(/\r?\n/).map((line) => line.trim()).find(Boolean) ?? "";
+  if (first === "STATUS: RESOLVED") return "resolved";
+  if (first === "STATUS: NEEDS_INPUT") return "needs-input";
+  if (first.startsWith("Respondeo turn failed:")) return "failed";
+  return "unknown";
+}
+
+async function readDetermination(path: string, rejectUnsafe = false): Promise<{ name: string; text: string } | null> {
+  const candidates = (await readdir(path, { withFileTypes: true })).flatMap((file) => {
+    if (!file.isFile()) return [];
+    const match = /^respondeo(?:-([0-9]+))?\.md$/.exec(file.name);
+    if (!match || match[0] !== file.name) return [];
+    const version = BigInt(match[1] ?? "1");
+    return version > 0n ? [{ name: file.name, version }] : [];
+  });
+  // BigInt preserves numerical ordering even beyond Number.MAX_SAFE_INTEGER.
+  // Equal versions use filename order so filesystem enumeration never breaks ties.
+  candidates.sort((a, b) => a.version === b.version
+    ? (a.name < b.name ? -1 : a.name > b.name ? 1 : 0)
+    : a.version > b.version ? -1 : 1);
+
+  for (const { name } of candidates) {
+    try {
+      const text = await readRegularArtifact(join(path, name));
+      if (text !== null) return { name, text };
+    } catch (error) {
+      if (!rejectUnsafe && (error as NodeJS.ErrnoException).code === "UNSAFE_PATH") continue;
+      throw error;
+    }
+  }
+  return null;
+}
+
+async function determinationMetadata(path: string): Promise<Pick<DebateEntry, "determination" | "status">> {
+  const determination = await readDetermination(path);
+  return determination
+    ? { determination: determination.name, status: classifyDetermination(determination.text) }
+    : { determination: null, status: "unjudged" };
+}
+
+/** Read exact artifact text. Determinations use the catalog's regular-file selection. */
+export async function readDebateArtifact(root: string, id: string, kind: DebateArtifactKind): Promise<string | null> {
+  if (!isDebateId(id)) {
+    throw Object.assign(new Error("id must be a debate directory basename"), { code: "INVALID_ID" });
+  }
+  if (kind !== "transcript" && kind !== "determination" && kind !== "final-report") {
+    throw Object.assign(new Error("Unknown debate artifact kind"), { code: "INVALID_QUERY" });
+  }
+  const path = join(resolve(root), id);
+  try {
+    const directory = await lstat(path);
+    if (directory.isSymbolicLink()) throw unsafePath();
+    if (!directory.isDirectory()) return null;
+    if (kind === "determination") return (await readDetermination(path, true))?.text ?? null;
+    return await readRegularArtifact(join(path, kind === "transcript" ? "debate.md" : "final-report.md"));
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return null;
+    throw error;
+  }
+}
+
+async function isRegularFile(path: string): Promise<boolean> {
+  try {
+    // lstat inspects the link itself, never its target.
+    return (await lstat(path)).isFile();
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return false;
+    throw error;
+  }
+}
+
+/**
+ * Read a newest-first page of immediate saved-debate directories without following child symlinks.
+ * Apply optional filters to the full catalog, then paginate the matching entries.
+ */
+export async function listDebates(root: string, options: ListDebatesOptions = {}): Promise<DebateEntry[]> {
+  const { offset = 0, limit, status, hasFinalReport: finalReportFilter } = options;
+  for (const [name, value] of [["offset", offset], ["limit", limit]] as const) {
+    if (value !== undefined && (!Number.isInteger(value) || value < 0)) {
+      throw Object.assign(new Error(`${name} must be a nonnegative integer`), { code: "INVALID_QUERY" });
+    }
+  }
+  if (status !== undefined && !CATALOG_STATUSES.has(status)) {
+    throw Object.assign(new Error("status must be a catalog status"), { code: "INVALID_QUERY" });
+  }
+  if (finalReportFilter !== undefined && typeof finalReportFilter !== "boolean") {
+    throw Object.assign(new Error("hasFinalReport must be a boolean"), { code: "INVALID_QUERY" });
+  }
+  const absoluteRoot = resolve(root);
+  let children;
+  try {
+    children = await readdir(absoluteRoot, { withFileTypes: true });
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return [];
+    throw error;
+  }
+
+  // Dirents classify symlinks as links, including links to directories. IDs are
+  // ASCII, so the default string sort gives code-point order without locale rules.
+  const ids = children
+    .filter((child) => child.isDirectory() && isDebateId(child.name))
+    .map((child) => child.name)
+    .sort()
+    .reverse();
+
+  const entries = await Promise.all(ids.map(async (id) => {
+    const path = join(absoluteRoot, id);
+    const [hasTranscript, hasFinalReport, metadata] = await Promise.all([
+      isRegularFile(join(path, "debate.md")),
+      isRegularFile(join(path, "final-report.md")),
+      determinationMetadata(path),
+    ]);
+    return { id, path, hasTranscript, hasFinalReport, ...metadata };
+  }));
+  // Offset and limit count matching debates. An omitted filter imposes no restriction.
+  const matches = entries.filter((entry) =>
+    (status === undefined || entry.status === status) &&
+    (finalReportFilter === undefined || entry.hasFinalReport === finalReportFilter));
+  return matches.slice(offset).slice(0, limit);
+}
