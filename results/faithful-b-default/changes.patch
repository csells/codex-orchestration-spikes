+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdir, mkdtemp, readFile, rm, symlink, writeFile } from "node:fs/promises";
+import { join, relative } from "node:path";
+import { tmpdir } from "node:os";
+import { classifyDetermination, listDebates, readDebateArtifact } from "../src/catalog.ts";
+
+async function fixture(t: { after: (fn: () => Promise<void>) => void }) {
+  const dir = await mkdtemp(join(tmpdir(), "disputatio-catalog-"));
+  t.after(() => rm(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+test("catalog filters immediate directories and sorts IDs in descending code-point order", async (t) => {
+  const root = await fixture(t);
+  const ids = ["debate-a", "debate-A_1.2-", "debate-9", "debate-Z"];
+  for (const id of [...ids, "other", "debate-", "debate-.bad", "debate-_bad", "debate-a b", "debate-é"]) {
+    await mkdir(join(root, id));
+  }
+  await mkdir(join(root, "other", "debate-nested"));
+  await mkdir(join(root, "debate-a", "debate-nested"));
+  await writeFile(join(root, "debate-file"), "unrelated");
+  await writeFile(join(root, "debate-a", "debate.md"), "transcript");
+  await writeFile(join(root, "debate-A_1.2-", "final-report.md"), "report");
+  await writeFile(join(root, "debate-Z", "debate.md"), "");
+  await writeFile(join(root, "debate-Z", "final-report.md"), "");
+
+  assert.deepEqual(await listDebates(relative(process.cwd(), root)), [
+    { id: "debate-a", path: join(root, "debate-a"), hasTranscript: true, hasFinalReport: false, determination: null, status: "unjudged" },
+    { id: "debate-Z", path: join(root, "debate-Z"), hasTranscript: true, hasFinalReport: true, determination: null, status: "unjudged" },
+    { id: "debate-A_1.2-", path: join(root, "debate-A_1.2-"), hasTranscript: false, hasFinalReport: true, determination: null, status: "unjudged" },
+    { id: "debate-9", path: join(root, "debate-9"), hasTranscript: false, hasFinalReport: false, determination: null, status: "unjudged" },
+  ]);
+});
+
+test("catalog ignores directory links and does not count artifact links or directories", async (t) => {
+  const base = await fixture(t);
+  const root = join(base, "catalog");
+  const outside = join(base, "outside");
+  await mkdir(root);
+  await mkdir(outside);
+  await writeFile(join(outside, "debate.md"), "untouched transcript");
+  await writeFile(join(outside, "final-report.md"), "untouched report");
+  await symlink(outside, join(root, "debate-linked"));
+  await symlink(join(base, "missing"), join(root, "debate-dangling"));
+  for (const id of ["debate-artifacts", "debate-directories", "debate-broken"]) {
+    await mkdir(join(root, id));
+    for (const name of ["debate.md", "final-report.md"]) {
+      const path = join(root, id, name);
+      if (id === "debate-directories") await mkdir(path);
+      else await symlink(join(id === "debate-broken" ? base : outside, name), path);
+    }
+  }
+  await symlink(join(root, "debate-directories"), join(root, "debate-internal-link"));
+
+  assert.deepEqual(await listDebates(root), ["debate-directories", "debate-broken", "debate-artifacts"].map((id) => ({
+    id, path: join(root, id), hasTranscript: false, hasFinalReport: false, determination: null, status: "unjudged",
+  })));
+  assert.equal(await readFile(join(outside, "debate.md"), "utf8"), "untouched transcript");
+  assert.equal(await readFile(join(outside, "final-report.md"), "utf8"), "untouched report");
+});
