+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+import { lstat, mkdir, mkdtemp, readFile, readdir, rm, symlink, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { fileURLToPath } from "node:url";
+import { listDebates } from "../src/catalog.ts";
+
+const execFileAsync = promisify(execFile);
+const cli = fileURLToPath(new URL("../src/catalog-cli.ts", import.meta.url));
+
+async function run(args: string[]) {
+  try {
+    // Use Node's absolute path; no participant CLI is available through PATH.
+    const result = await execFileAsync(process.execPath, [cli, ...args], {
+      env: { ...process.env, PATH: "" }, timeout: 10_000,
+    });
+    return { ...result, code: 0 };
+  } catch (error) {
+    const result = error as { stdout: string; stderr: string; code: number };
+    return { stdout: result.stdout, stderr: result.stderr, code: result.code };
+  }
+}
+
+async function fixture(t: { after: (fn: () => Promise<void>) => void }) {
+  const root = await mkdtemp(join(tmpdir(), "disputatio-catalog-cli-"));
+  t.after(() => rm(root, { recursive: true, force: true }));
+  return root;
+}
+
+test("catalog CLI prints API JSON with arbitrary flag order and filters before pagination", async (t) => {
+  const root = join(await fixture(t), "saved debates");
+  await mkdir(root);
+  for (const [id, report, text] of [
+    ["debate-04", true, "STATUS: RESOLVED"],
+    ["debate-03", false, "STATUS: NEEDS_INPUT"],
+    ["debate-02", true, "STATUS: RESOLVED"],
+    ["debate-01", false, null],
+  ] as const) {
+    const path = join(root, id);
+    await mkdir(path);
+    if (report) await writeFile(join(path, "final-report.md"), "report");
+    if (text) await writeFile(join(path, "respondeo.md"), text);
+  }
+  const queries = [
+    { args: ["--root", root], options: {} },
+    { args: ["--limit", "1", "--has-final-report", "yes", "--root", root, "--offset", "1", "--status", "resolved"],
+      options: { limit: 1, hasFinalReport: true, offset: 1, status: "resolved" } },
+    { args: ["--has-final-report", "no", "--root", root], options: { hasFinalReport: false } },
+    { args: ["--status", "unjudged", "--root", root], options: { status: "unjudged" } },
+    { args: ["--root", root, "--offset", "0", "--limit", "0"], options: { offset: 0, limit: 0 } },
+  ] as const;
+  for (const { args, options } of queries) {
+    const result = await run([...args]);
+    assert.equal(result.code, 0, result.stderr);
+    assert.equal(result.stderr, "");
+    assert.deepEqual(JSON.parse(result.stdout), await listDebates(root, options));
+  }
+});
+
+test("catalog CLI prints [] for a missing root without creating it", async (t) => {
+  const root = join(await fixture(t), "missing");
+  const result = await run(["--root", root]);
+  assert.equal(result.code, 0, result.stderr);
+  assert.equal(result.stderr, "");
+  assert.deepEqual(JSON.parse(result.stdout), []);
+  await assert.rejects(lstat(root), { code: "ENOENT" });
+});
+
+test("catalog CLI rejects argument and query errors with empty stdout and INVALID_QUERY", async (t) => {
+  const root = join(await fixture(t), "missing");
+  const cases: string[][] = [[], ["--status", "resolved"], ["--unknown"], ["--root", root, "extra"],
+    ["--root", root, "--root", root], ["--root", root, "--doctor"]];
+  for (const flag of ["--root", "--status", "--has-final-report", "--offset", "--limit", "--id", "--artifact"]) {
+    cases.push([flag], [flag, ""], [flag, "--root", root]);
+  }
+  for (const value of ["YES", "true", "false", "0", "maybe"]) cases.push(["--root", root, "--has-final-report", value]);
+  for (const value of ["RESOLVED", "needs_input", "other"]) cases.push(["--root", root, "--status", value]);
+  for (const flag of ["--offset", "--limit"]) {
+    for (const value of ["-1", "1.5", "NaN", "Infinity", "1x", "1e2", "0x10", " "]) cases.push(["--root", root, flag, value]);
+  }
+  for (const args of cases) {
+    const result = await run(args);
+    assert.equal(result.code, 1, JSON.stringify(args));
+    assert.equal(result.stdout, "", JSON.stringify(args));
+    assert.match(result.stderr, /INVALID_QUERY: .+/, JSON.stringify(args));
+  }
+});
+
+test("catalog CLI preserves files and ignores child and artifact symlinks", async (t) => {
+  const base = await fixture(t);
+  const root = join(base, "catalog");
+  const outside = join(base, "outside");
+  await mkdir(root);
+  await mkdir(outside);
+  await writeFile(join(outside, "respondeo.md"), "STATUS: RESOLVED");
+  await symlink(outside, join(root, "debate-link"));
+  await mkdir(join(root, "debate-real"));
+  for (const name of ["debate.md", "respondeo.md", "final-report.md"]) {
+    await symlink(join(outside, "respondeo.md"), join(root, "debate-real", name));
+  }
+  const before = await readdir(base, { recursive: true });
+  const result = await run(["--root", root]);
+  assert.equal(result.code, 0, result.stderr);
+  assert.deepEqual(JSON.parse(result.stdout), [{
+    id: "debate-real", path: join(root, "debate-real"), hasTranscript: false,
+    hasFinalReport: false, determination: null, status: "unjudged",
+  }]);
+  assert.deepEqual(await readdir(base, { recursive: true }), before);
+  assert.equal(await readFile(join(outside, "respondeo.md"), "utf8"), "STATUS: RESOLVED");
+});
+
+test("catalog CLI reports filesystem failures without partial JSON", async (t) => {
+  const root = join(await fixture(t), "file");
+  await writeFile(root, "not a directory");
+  const result = await run(["--root", root]);
+  assert.equal(result.code, 1);
+  assert.equal(result.stdout, "");
+  assert.match(result.stderr, /ENOTDIR/);
+});
+
+test("catalog CLI artifact mode prints exact text for all kinds without an added newline", async (t) => {
+  const root = await fixture(t);
+  const id = "debate-text";
+  const path = join(root, id);
+  await mkdir(path);
+  await writeFile(join(path, "respondeo.md"), "older determination");
+  await writeFile(join(path, "respondeo-2.md"), "also older");
+  for (const [kind, name, text] of [
+    ["transcript", "debate.md", "\uFEFF\r\n café 🌍\t  "],
+    ["determination", "respondeo-10.md", "\nSTATUS: RESOLVED\r\n verdict\n\n"],
+    ["final-report", "final-report.md", ""],
+  ]) {
+    await writeFile(join(path, name), text);
+    const before = await lstat(join(path, name));
+    const result = await run(["--artifact", kind, "--root", root, "--id", id]);
+    assert.equal(result.code, 0, result.stderr);
+    assert.equal(result.stderr, "");
+    assert.equal(result.stdout, text);
+    assert.equal(await readFile(join(path, name), "utf8"), text);
+    assert.equal((await lstat(join(path, name))).mtimeMs, before.mtimeMs);
+  }
+});
+
+test("catalog CLI artifact mode returns NOT_FOUND and exit 2 for absent artifacts or directories", async (t) => {
+  const root = await fixture(t);
+  const id = "debate-empty";
+  await mkdir(join(root, id));
+  for (const [directory, debate, kind] of [
+    [root, id, "transcript"], [root, id, "determination"], [root, id, "final-report"],
+    [root, "debate-missing", "transcript"], [join(root, "missing"), id, "transcript"],
+  ]) {
+    const result = await run(["--root", directory, "--id", debate, "--artifact", kind]);
+    assert.equal(result.code, 2, result.stderr);
+    assert.equal(result.stdout, "");
+    assert.match(result.stderr, /NOT_FOUND/);
+  }
+  await assert.rejects(lstat(join(root, "missing")), { code: "ENOENT" });
+});
+
+test("catalog CLI artifact mode validates paired flags, incompatible list options, IDs, and kinds", async (t) => {
+  const root = join(await fixture(t), "missing");
+  const cases: [string[], string][] = [
+    [["--id", "debate-ok"], "INVALID_QUERY"],
+    [["--artifact", "transcript"], "INVALID_QUERY"],
+    [["--id", "../debate-other", "--artifact", "transcript"], "INVALID_ID"],
+    [["--id", "debate-ok", "--artifact", "unknown"], "INVALID_QUERY"],
+  ];
+  for (const [flag, value] of [["--status", "resolved"], ["--has-final-report", "no"], ["--offset", "0"], ["--limit", "0"]]) {
+    cases.push([[flag, value, "--id", "debate-ok", "--artifact", "transcript"], "INVALID_QUERY"]);
+  }
+  for (const [args, code] of cases) {
+    const result = await run(["--root", root, ...args]);
+    assert.equal(result.code, 1, JSON.stringify(args));
+    assert.equal(result.stdout, "");
+    assert.ok(result.stderr.includes(code), result.stderr);
+  }
+});
+
+test("catalog CLI artifact mode reports UNSAFE_PATH for directory and artifact symlinks", async (t) => {
+  const base = await fixture(t);
+  const root = join(base, "catalog");
+  const outside = join(base, "outside");
+  await mkdir(root);
+  await mkdir(outside);
+  await writeFile(join(outside, "debate.md"), "outside text");
+  await symlink(outside, join(root, "debate-linked"));
+  await mkdir(join(root, "debate-real"));
+  await symlink(join(outside, "debate.md"), join(root, "debate-real", "debate.md"));
+  await symlink(join(outside, "missing"), join(root, "debate-real", "final-report.md"));
+  for (const [id, kind] of [["debate-linked", "determination"], ["debate-real", "transcript"], ["debate-real", "final-report"]]) {
+    const result = await run(["--root", root, "--id", id, "--artifact", kind]);
+    assert.equal(result.code, 1, result.stderr);
+    assert.equal(result.stdout, "");
+    assert.match(result.stderr, /UNSAFE_PATH/);
+  }
+  assert.equal(await readFile(join(outside, "debate.md"), "utf8"), "outside text");
+});
