@@ -0,0 +1,57 @@
+#!/bin/sh
+# Fake Codex executable for timeout transport tests. It deliberately behaves
+# like a CLI wrapper that either exits while a TERM-ignoring worker owns its
+# stdio pipes, or ignores TERM itself. No real agent process is involved.
+
+record_pid() {
+  [ -n "$FAKE_PID_FILE" ] && printf '%s\n' "$1" >> "$FAKE_PID_FILE"
+}
+
+printf 'root stdout before timeout\n'
+printf 'root stderr before timeout\n' >&2
+record_pid "$$"
+
+case "$FAKE_TIMEOUT_MODE" in
+  exited-root-with-worker-pipes)
+    (
+      trap '' TERM
+      printf 'worker stdout before timeout\n'
+      printf 'worker stderr before timeout\n' >&2
+      while :; do sleep 1; done
+    ) &
+    record_pid "$!"
+    # This models a wrapper that has already gone away; its worker still owns
+    # the captured descriptors when the adapter's wall-clock deadline fires.
+    exit 0
+    ;;
+  root-terminates-worker-pipes)
+    (
+      trap '' TERM
+      printf 'worker stdout before timeout\n'
+      printf 'worker stderr before timeout\n' >&2
+      while :; do sleep 1; done
+    ) &
+    record_pid "$!"
+    # The root keeps running with its default TERM disposition. On timeout it
+    # exits, but the inherited descriptors remain open in the worker.
+    while :; do sleep 1; done
+    ;;
+  root-terminates-worker-without-pipes)
+    (
+      trap '' TERM
+      while :; do sleep 1; done
+    ) >/dev/null 2>&1 &
+    record_pid "$!"
+    # Here close can arrive immediately after the root sees TERM. Escalation
+    # must still happen so the worker cannot escape the timeout.
+    while :; do sleep 1; done
+    ;;
+  root-ignores-term)
+    trap '' TERM
+    while :; do sleep 1; done
+    ;;
+  *)
+    printf 'missing FAKE_TIMEOUT_MODE\n' >&2
+    exit 64
+    ;;
+esac
