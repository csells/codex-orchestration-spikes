--- a/test/adapters-timeout.test.ts
+++ b/test/adapters-timeout.test.ts
@@ -0,0 +1,139 @@
+// Timeout transport regressions. These exercise the public Codex adapter with
+// a local executable that leaves TERM-ignoring processes holding stdout/stderr.
+
+import { afterEach, test } from "node:test";
+import assert from "node:assert/strict";
+import { access, mkdtemp, readFile, rm } from "node:fs/promises";
+import { join, dirname } from "node:path";
+import { tmpdir } from "node:os";
+import { fileURLToPath } from "node:url";
+import { codexAdapter } from "../src/adapters.ts";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const fake = join(here, "fakes", "codex-timeout");
+const testDirs: string[] = [];
+
+afterEach(async () => {
+  await Promise.all(testDirs.splice(0).map((dir) => rm(dir, { recursive: true, force: true })));
+});
+
+const delay = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+async function pidIsGone(pid: number): Promise<boolean> {
+  try {
+    process.kill(pid, 0);
+    return false;
+  } catch (error: any) {
+    return error?.code === "ESRCH";
+  }
+}
+
+async function waitForPids(file: string, count: number): Promise<number[]> {
+  const deadline = Date.now() + 1_000;
+  while (Date.now() < deadline) {
+    try {
+      const pids = (await readFile(file, "utf8"))
+        .trim().split("\n").filter(Boolean).map(Number);
+      if (pids.length >= count) return pids;
+    } catch (error: any) {
+      if (error?.code !== "ENOENT") throw error;
+    }
+    await delay(10);
+  }
+  throw new Error(`fake did not record ${count} PID(s)`);
+}
+
+async function recordedPids(file: string): Promise<number[]> {
+  try {
+    return (await readFile(file, "utf8")).trim().split("\n").filter(Boolean).map(Number);
+  } catch (error: any) {
+    if (error?.code === "ENOENT") return [];
+    throw error;
+  }
+}
+
+async function killPids(pids: number[]) {
+  for (const pid of pids) {
+    try { process.kill(pid, "SIGKILL"); } catch (error: any) {
+      if (error?.code !== "ESRCH") throw error;
+    }
+  }
+}
+
+async function expectGone(pids: number[]) {
+  const deadline = Date.now() + 1_000;
+  while (Date.now() < deadline) {
+    if ((await Promise.all(pids.map(pidIsGone))).every(Boolean)) return;
+    await delay(10);
+  }
+  assert.fail(`fake process(es) still alive: ${pids.join(", ")}`);
+}
+
+async function settlesBefore<T>(run: Promise<T>, ms: number): Promise<T | undefined> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    return await Promise.race([
+      run,
+      new Promise<undefined>((resolve) => { timer = setTimeout(() => resolve(undefined), ms); }),
+    ]);
+  } finally {
+    if (timer) clearTimeout(timer);
+  }
+}
+
+async function runTimeoutCase(mode: string, pidCount: number, workerOwnsPipes: boolean) {
+  await access(fake);
+  const dir = await mkdtemp(join(tmpdir(), "disputatio-timeout-"));
+  testDirs.push(dir);
+  const pidFile = join(dir, "pids");
+  const oldMode = process.env.FAKE_TIMEOUT_MODE;
+  const oldPids = process.env.FAKE_PID_FILE;
+  process.env.FAKE_TIMEOUT_MODE = mode;
+  process.env.FAKE_PID_FILE = pidFile;
+
+  let pids: number[] = [];
+  const started = Date.now();
+  const run = codexAdapter(undefined, { bin: fake, timeoutMs: 300 }).run("ping", dir);
+  try {
+    pids = await waitForPids(pidFile, pidCount);
+    const result = await settlesBefore(run, 1_500);
+    assert.notEqual(result, undefined, "timeout result must not wait for inherited pipes");
+    assert.equal(result!.ok, false);
+    assert.equal(!result!.ok && result!.error, "timeout");
+    assert.ok(Date.now() - started < 1_600, "timeout should return promptly");
+    assert.equal(result!.raw?.timedOut, true);
+    assert.match(result!.raw?.stdout ?? "", /root stdout before timeout/);
+    assert.match(result!.raw?.stderr ?? "", /root stderr before timeout/);
+    if (workerOwnsPipes) {
+      assert.match(result!.raw?.stdout ?? "", /worker stdout before timeout/);
+      assert.match(result!.raw?.stderr ?? "", /worker stderr before timeout/);
+    }
+    await expectGone(pids);
+  } finally {
+    pids = [...new Set([...pids, ...await recordedPids(pidFile)])];
+    await killPids(pids);
+    // On the vulnerable implementation this releases the inherited pipes so
+    // the pending public adapter promise can settle before the test ends.
+    await settlesBefore(run, 2_000);
+    if (oldMode === undefined) delete process.env.FAKE_TIMEOUT_MODE;
+    else process.env.FAKE_TIMEOUT_MODE = oldMode;
+    if (oldPids === undefined) delete process.env.FAKE_PID_FILE;
+    else process.env.FAKE_PID_FILE = oldPids;
+  }
+}
+
+test("codex timeout: exited wrapper's TERM-ignoring worker cannot hold captured pipes open", { concurrency: false }, async () => {
+  await runTimeoutCase("exited-root-with-worker-pipes", 2, true);
+});
+
+test("codex timeout: TERM ends the root and then SIGKILL clears its pipe-owning worker", { concurrency: false }, async () => {
+  await runTimeoutCase("root-terminates-worker-pipes", 2, true);
+});
+
+test("codex timeout: escalation survives close when the worker has no captured pipes", { concurrency: false }, async () => {
+  await runTimeoutCase("root-terminates-worker-without-pipes", 2, false);
+});
+
+test("codex timeout: TERM-ignoring root is escalated and partial output is retained", { concurrency: false }, async () => {
+  await runTimeoutCase("root-ignores-term", 1, false);
+});
