--- a/test/fakes/timeout-cli
+++ b/test/fakes/timeout-cli
@@ -0,0 +1,21 @@
+#!/usr/bin/env node
+// Local timeout reproduction: all processes stay alive until signaled.
+import { spawn } from "node:child_process";
+import { appendFileSync } from "node:fs";
+const record = (event) => appendFileSync(process.env.FAKE_PROCESS_LOG, `${event}\n`);
+const worker = process.argv[2] === "worker";
+record(`pid ${process.pid}`);
+process.on("SIGTERM", () => {
+  record(`term ${process.pid}`);
+  if (!worker && process.env.FAKE_TIMEOUT_MODE !== "ignore") process.exit(0);
+});
+if (!worker) {
+  process.stdout.write("partial stdout\n");
+  process.stderr.write("partial stderr\n");
+  if (process.env.FAKE_TIMEOUT_MODE !== "ignore") {
+    spawn(process.execPath, [import.meta.filename, "worker"], {
+      stdio: process.env.FAKE_TIMEOUT_MODE === "closed-pipes" ? "ignore" : "inherit",
+    });
+  }
+}
+setInterval(() => {}, 1000);
--- a/test/timeout.test.ts
+++ b/test/timeout.test.ts
@@ -0,0 +1,74 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { setTimeout as delay } from "node:timers/promises";
+import { codexAdapter } from "../src/adapters.ts";
+
+const bin = fileURLToPath(new URL("./fakes/timeout-cli", import.meta.url));
+
+function running(pid: number): boolean {
+  try { process.kill(pid, 0); return true; }
+  catch (e: any) { if (e.code === "ESRCH") return false; throw e; }
+}
+
+test("spawn failure is captured without becoming a timeout", async () => {
+  const dir = mkdtempSync(join(tmpdir(), "cli-missing-"));
+  try {
+    const r = await codexAdapter(undefined, { bin: join(dir, "missing"), timeoutMs: 700 }).run("ping", dir);
+    assert.equal(r.ok, false);
+    assert.equal(r.raw?.timedOut, false);
+    assert.match(r.raw?.stderr ?? "", /ENOENT/);
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+for (const mode of ["inherited-pipes", "ignore", "closed-pipes"]) {
+  test(`timeout: ${mode} terminates promptly and leaves no live workers`, {
+    skip: process.platform === "win32", // POSIX process groups and signals
+  }, async () => {
+    const dir = mkdtempSync(join(tmpdir(), "cli-timeout-"));
+    const log = join(dir, "processes.log");
+    process.env.FAKE_PROCESS_LOG = log;
+    process.env.FAKE_TIMEOUT_MODE = mode;
+    const events = () => {
+      try { return readFileSync(log, "utf8").trim().split("\n"); }
+      catch (e: any) { if (e.code === "ENOENT") return []; throw e; }
+    };
+    const pids = () => events().filter((s) => s.startsWith("pid ")).map((s) => Number(s.slice(4)));
+    const cleanup = () => {
+      for (const pid of pids()) {
+        try { process.kill(pid, "SIGKILL"); }
+        catch (e: any) { if (e.code !== "ESRCH") throw e; }
+      }
+    };
+    // Bound the reproduction even when run against the broken implementation.
+    const watchdog = setTimeout(cleanup, 4000);
+    try {
+      const started = performance.now();
+      const r = await codexAdapter(undefined, { bin, timeoutMs: 700 }).run("ping", dir);
+      const elapsed = performance.now() - started;
+      assert.equal(r.ok, false);
+      assert.equal(!r.ok && r.error, "timeout");
+      assert.equal(r.raw?.timedOut, true);
+      assert.equal(r.raw?.stdout, "partial stdout\n");
+      assert.equal(r.raw?.stderr, "partial stderr\n");
+      assert.ok(elapsed < 2500, `timeout took ${elapsed.toFixed(0)}ms`);
+      const ids = pids();
+      assert.equal(ids.length, mode === "ignore" ? 1 : 2);
+      for (const pid of ids) assert.ok(events().includes(`term ${pid}`), `PID ${pid} received SIGTERM`);
+      const deadline = performance.now() + 1000;
+      while (ids.some(running) && performance.now() < deadline) await delay(20);
+      for (const pid of ids) assert.equal(running(pid), false, `PID ${pid} survived timeout`);
+    } finally {
+      clearTimeout(watchdog);
+      cleanup();
+      delete process.env.FAKE_PROCESS_LOG;
+      delete process.env.FAKE_TIMEOUT_MODE;
+      rmSync(dir, { recursive: true, force: true });
+    }
+  });
+}
