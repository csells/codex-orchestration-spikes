+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { chmod, mkdtemp, mkdir, readFile, rm, writeFile } from "node:fs/promises";
+import { execFile as execFileCallback } from "node:child_process";
+import { promisify } from "node:util";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { parseDebateConfig, serializeDebateConfig } from "../src/config.ts";
+
+const execFile = promisify(execFileCallback);
+const cliPath = fileURLToPath(new URL("../src/profile-cli.ts", import.meta.url));
+
+async function inTempDir(run: (dir: string) => Promise<void>): Promise<void> {
+  const dir = await mkdtemp(join(tmpdir(), "disputatio-profile-cli-"));
+  try {
+    await run(dir);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+}
+
+type CliResult = { code: number; stdout: string; stderr: string };
+
+async function runCli(cwd: string, args: string[], sentinelDir?: string, marker?: string): Promise<CliResult> {
+  try {
+    const result = await execFile(process.execPath, [cliPath, ...args], {
+      cwd,
+      env: { PATH: sentinelDir ?? process.env.PATH, SENTINEL_MARKER: marker },
+    });
+    return { code: 0, stdout: result.stdout, stderr: result.stderr };
+  } catch (error) {
+    const failed = error as Error & { code?: number | string; stdout?: string; stderr?: string };
+    return { code: typeof failed.code === "number" ? failed.code : 1, stdout: failed.stdout ?? "", stderr: failed.stderr ?? "" };
+  }
+}
