+test("reports argument and loader failures on stderr without YAML output", async () => {
+  await inTempDir(async (dir) => {
+    const bundlePath = join(dir, "bundle.json");
+    const badYamlPath = join(dir, "bad.yaml");
+    await writeFile(badYamlPath, "participants:\n  - adapter: unknown\n");
+    await writeFile(bundlePath, JSON.stringify({
+      version: 1,
+      defaultProfile: "fast",
+      profiles: { fast: { overrides: { rounds: 0 } } },
+    }));
+    for (const args of [
+      [],
+      ["--bundle"],
+      ["--bundle="],
+      ["--profile"],
+      ["--profile", "fast"],
+      ["--bundle", "--profile", "fast"],
+      ["--bundle", "bundle.json", "--profile"],
+      ["--bundle", "bundle.json", "--profile="],
+      ["--unknown"],
+      ["--bundle", "bundle.json", "--unknown"],
+      ["--bundle", "bundle.json", "extra"],
+    ]) {
+      const result = await runCli(dir, args);
+      assert.equal(result.code, 1);
+      assert.equal(result.stdout, "");
+      assert.notEqual(result.stderr, "");
+    }
+
+    const failures: Array<{ bundle: unknown; expected: string }> = [
+      { bundle: "{", expected: "INVALID_BUNDLE" },
+      { bundle: { version: 1, profiles: {} }, expected: "PROFILE_REQUIRED" },
+      { bundle: { version: 1, profiles: { fast: { config: "missing.yaml" } } }, expected: "ENOENT" },
+      { bundle: { version: 1, profiles: { fast: { config: "bad.yaml" } } }, expected: "debate config" },
+      { bundle: { version: 1, profiles: { fast: { extends: "missing" } } }, expected: "UNKNOWN_PROFILE" },
+      { bundle: { version: 1, profiles: { fast: { extends: "fast" } } }, expected: "PROFILE_CYCLE" },
+      { bundle: { version: 1, profiles: { fast: { config: "../outside.yaml" } } }, expected: "UNSAFE_CONFIG_PATH" },
+    ];
+    for (const { bundle, expected } of failures) {
+      const source = typeof bundle === "string" ? bundle : JSON.stringify(bundle);
+      await writeFile(bundlePath, source);
+      const args = expected === "PROFILE_REQUIRED"
+        ? ["--bundle", "bundle.json"]
+        : ["--bundle", "bundle.json", "--profile", "fast"];
+      for (const format of [[], ["--json"]]) {
+        const result = await runCli(dir, [...args, ...format]);
+        assert.equal(result.code, 1);
+        assert.equal(result.stdout, "");
+        assert.match(result.stderr, new RegExp(expected));
+      }
+      assert.equal(await readFile(bundlePath, "utf8"), source);
+    }
+  });
+});
