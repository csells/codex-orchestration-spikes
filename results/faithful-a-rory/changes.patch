+#!/usr/bin/env node
+// Render a bundle profile for use with Disputatio --config, without running it.
+import { parseArgs } from "node:util";
+import { serializeDebateConfig } from "./config.ts";
+import { listProfiles, loadProfileBundle } from "./profile-bundle.ts";
+
+try {
+  const { values } = parseArgs({
+    options: {
+      bundle: { type: "string" },
+      profile: { type: "string" },
+      list: { type: "boolean" },
+      json: { type: "boolean" },
+    },
+    strict: true,
+    allowPositionals: false,
+  });
+  if (!values.bundle) throw new Error("--bundle FILE is required");
+  if (values.list && (values.profile !== undefined || values.json)) {
+    throw new Error("--list cannot be combined with --profile or --json");
+  }
+  if (values.profile === "") throw new Error("--profile requires a name");
+
+  let output: string;
+  if (values.list) {
+    output = JSON.stringify(await listProfiles(values.bundle)) + "\n";
+  } else {
+    const config = await loadProfileBundle(values.bundle, values.profile);
+    output = values.json ? JSON.stringify(config, null, 2) + "\n" : serializeDebateConfig(config);
+  }
+  // Finish loading and serialization before writing anything to stdout.
+  process.stdout.write(output);
+} catch (error) {
+  const message = error instanceof Error ? error.message : String(error);
+  const code = error !== null && typeof error === "object" && "code" in error ? String(error.code) : undefined;
+  process.stderr.write(`profile-cli: ${code ? `${code}: ` : ""}${message}\n`);
+  process.stderr.write("usage: node src/profile-cli.ts --bundle FILE [--profile NAME] [--json]\n");
+  process.stderr.write("       node src/profile-cli.ts --bundle FILE --list\n");
+  process.exitCode = 1;
+}
