+    assert.equal(jsonDefault.code, 0);
+    assert.equal(jsonDefault.stderr, "");
+    assert.deepEqual(JSON.parse(jsonDefault.stdout), child);
+    assert.equal(jsonExplicit.code, 0);
+    assert.equal(jsonExplicit.stderr, "");
+    assert.deepEqual(JSON.parse(jsonExplicit.stdout), base);
+    await assert.rejects(() => readFile(marker), (error: unknown) => (error as NodeJS.ErrnoException).code === "ENOENT");
+    assert.equal(await readFile(join(profilesDir, "bundle.json"), "utf8"), bundleText);
+    assert.equal(await readFile(join(profilesDir, "base.yaml"), "utf8"), baseText);
+    assert.equal(await readFile(join(profilesDir, "child.yaml"), "utf8"), childText);
+  });
+});
