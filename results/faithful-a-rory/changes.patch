+test("renders the effective default or explicit profile as canonical YAML without launching agents", async () => {
+  await inTempDir(async (dir) => {
+    const profilesDir = join(dir, "profiles");
+    const sentinelDir = join(dir, "sentinel-bin");
+    const marker = join(dir, "sentinel-ran");
+    await mkdir(profilesDir);
+    await mkdir(sentinelDir);
+    await writeFile(join(sentinelDir, "sentinel"), "#!/bin/sh\necho invoked > \"$SENTINEL_MARKER\"\n");
+    await chmod(join(sentinelDir, "sentinel"), 0o755);
+    const bundleText = JSON.stringify({
+      version: 1,
+      defaultProfile: "child",
+      profiles: {
+        base: { config: "base.yaml" },
+        child: { extends: "base", config: "child.yaml", overrides: { repo: "inline", judge: null } },
+      },
+    }, null, 2);
+    const baseText = [
+      "rounds: 2",
+      "timeoutMinutes: 8",
+      "participants:",
+      "  - adapter: claude",
+      "    model: base-claude",
+      "    bin: sentinel",
+      "  - adapter: codex",
+      "    model: base-codex",
+      "    bin: sentinel",
+      "judge:",
+      "  adapter: claude",
+      "  bin: sentinel",
+      "",
+    ].join("\n");
+    const childText = [
+      "rounds: 0",
+      "participants:",
+      "  - adapter: pi",
+      "    model: child-pi",
+      "    bin: sentinel",
+      "  - adapter: claude",
+      "    model: child-claude",
+      "    bin: sentinel",
+      "",
+    ].join("\n");
+    await writeFile(join(profilesDir, "bundle.json"), bundleText);
+    await writeFile(join(profilesDir, "base.yaml"), baseText);
+    await writeFile(join(profilesDir, "child.yaml"), childText);
+
+    const child = {
+      rounds: 0,
+      repo: "inline",
+      timeoutMinutes: 8,
+      participants: [
+        { adapter: "pi" as const, model: "child-pi", bin: "sentinel" },
+        { adapter: "claude" as const, model: "child-claude", bin: "sentinel" },
+      ],
+    };
+    const base = {
+      rounds: 2,
+      timeoutMinutes: 8,
+      participants: [
+        { adapter: "claude" as const, model: "base-claude", bin: "sentinel" },
+        { adapter: "codex" as const, model: "base-codex", bin: "sentinel" },
+      ],
+      judge: { adapter: "claude" as const, bin: "sentinel" },
+    };
+    const defaultResult = await runCli(dir, ["--bundle", "profiles/bundle.json"], sentinelDir, marker);
+    const explicitResult = await runCli(dir, ["--bundle=profiles/bundle.json", "--profile", "base"], sentinelDir, marker);
+    const jsonDefault = await runCli(dir, ["--json", "--bundle", "profiles/bundle.json"], sentinelDir, marker);
+    const jsonExplicit = await runCli(dir, ["--bundle=profiles/bundle.json", "--profile", "base", "--json"], sentinelDir, marker);
+    assert.deepEqual(defaultResult, { code: 0, stdout: serializeDebateConfig(child), stderr: "" });
