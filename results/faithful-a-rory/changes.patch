+const CONFIG = [
+  "rounds: 2",
+  "participants:",
+  "  - adapter: claude",
+  "    model: sonnet",
+  "  - adapter: codex",
+  "judge:",
+  "  adapter: claude",
+  "  model: opus",
+  "",
+].join("\n");
+
+async function inTempDir(run: (dir: string) => Promise<void>): Promise<void> {
+  const dir = await mkdtemp(join(tmpdir(), "disputatio-profile-bundle-"));
+  try {
+    await run(dir);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+}
+
+async function expectBundleError(
+  action: () => Promise<unknown>,
+  code: "INVALID_BUNDLE" | "UNKNOWN_PROFILE" | "PROFILE_REQUIRED" | "PROFILE_CYCLE" | "UNSAFE_CONFIG_PATH",
+): Promise<void> {
+  await assert.rejects(action, (error: unknown) => {
+    assert.ok(error instanceof Error);
+    assert.equal((error as { code?: unknown }).code, code);
+    return true;
+  });
+}
