+import { readFile, realpath } from "node:fs/promises";
+import { dirname, isAbsolute, relative, resolve, sep } from "node:path";
+import { isDeepStrictEqual } from "node:util";
+import { parseDebateConfigOverlay, serializeDebateConfig, type DebateConfig } from "./config.ts";
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function bundleError(code: "INVALID_BUNDLE" | "UNKNOWN_PROFILE" | "PROFILE_REQUIRED" | "PROFILE_CYCLE" | "UNSAFE_CONFIG_PATH", message: string): Error {
+  return Object.assign(new Error(message), { code });
+}
+
+function isWithinDirectory(directory: string, target: string): boolean {
+  const path = relative(directory, target);
+  return path !== ".." && !path.startsWith(`..${sep}`) && !isAbsolute(path);
+}
+
+async function resolveConfigPath(bundleDirectory: string, configPath: string): Promise<string> {
+  const target = resolve(bundleDirectory, configPath);
+  if (isAbsolute(configPath) || !isWithinDirectory(bundleDirectory, target)) {
+    throw bundleError("UNSAFE_CONFIG_PATH", `Config path must be relative and stay within the bundle directory: ${JSON.stringify(configPath)}`);
+  }
+  const realTarget = await realpath(target);
+  if (!isWithinDirectory(bundleDirectory, realTarget)) {
+    throw bundleError("UNSAFE_CONFIG_PATH", `Config path resolves outside the bundle directory: ${JSON.stringify(configPath)}`);
+  }
+  return realTarget;
+}
+
+const OVERRIDE_KEYS = new Set(["rounds", "repo", "timeoutMinutes", "participants", "judge"]);
+
+function parseOverrides(value: unknown): { config: DebateConfig; removeJudge: boolean } {
+  if (!isObject(value)) {
+    throw bundleError("INVALID_BUNDLE", "Profile overrides must be an object");
+  }
+  for (const key of Object.keys(value)) {
+    if (!OVERRIDE_KEYS.has(key)) {
+      throw bundleError("INVALID_BUNDLE", `Unknown override key: ${key}`);
+    }
+  }
+  const settings = { ...value };
+  const removeJudge = settings.judge === null;
+  if (removeJudge) delete settings.judge;
+  try {
+    const config = parseDebateConfigOverlay(serializeDebateConfig(settings as DebateConfig));
+    // The serializer only emits known fields, and YAML can coerce scalar types.
+    // Require a lossless round trip so neither can hide invalid supplied settings.
+    if (!isDeepStrictEqual(config, settings)) {
+      throw new Error("Override settings must match DebateConfig types and round-trip without loss");
+    }
+    return { config, removeJudge };
+  } catch (error) {
+    throw bundleError("INVALID_BUNDLE", `Invalid profile overrides: ${error instanceof Error ? error.message : String(error)}`);
+  }
+}
+
+async function readBundleEnvelope(bundlePath: string) {
+  const realBundlePath = await realpath(bundlePath);
+  const bundleDirectory = dirname(realBundlePath);
+  const text = await readFile(realBundlePath, "utf8");
+  let bundle: unknown;
+  try {
+    bundle = JSON.parse(text);
+  } catch {
+    throw bundleError("INVALID_BUNDLE", `Invalid JSON in profile bundle: ${bundlePath}`);
+  }
+
+  if (!isObject(bundle) || bundle.version !== 1) {
+    throw bundleError("INVALID_BUNDLE", "Profile bundle must be an object with version 1");
+  }
+  if (!isObject(bundle.profiles)) {
+    throw bundleError("INVALID_BUNDLE", "Profile bundle profiles must be an object");
+  }
+  return { bundle, profiles: bundle.profiles, bundleDirectory };
+}
+
+// Default string sorting compares UTF-16 units, which misorders supplementary
+// characters relative to some BMP characters. Compare Unicode code points.
+function compareProfileNames(left: string, right: string): number {
+  let leftIndex = 0;
+  let rightIndex = 0;
+  while (leftIndex < left.length && rightIndex < right.length) {
+    const leftPoint = left.codePointAt(leftIndex)!;
+    const rightPoint = right.codePointAt(rightIndex)!;
+    if (leftPoint !== rightPoint) return leftPoint - rightPoint;
+    leftIndex += leftPoint > 0xffff ? 2 : 1;
+    rightIndex += rightPoint > 0xffff ? 2 : 1;
+  }
+  return left.length - right.length;
+}
+
+// Listing needs only the envelope; profile contents and referenced files are not
+// resolved, and no default selection is required.
+export async function listProfiles(bundlePath: string): Promise<string[]> {
+  const { profiles } = await readBundleEnvelope(bundlePath);
+  return Object.keys(profiles).sort(compareProfileNames);
+}
+
+// Read and parse anew on every load so callers own all returned objects, including
+// participant and judge specs. Loading never writes to the bundle or its configs.
+export async function loadProfileBundle(bundlePath: string, profileName?: string): Promise<DebateConfig> {
+  const { bundle, profiles, bundleDirectory } = await readBundleEnvelope(bundlePath);
+  let name = profileName;
+  if (name === undefined) {
+    if (!Object.hasOwn(bundle, "defaultProfile")) {
+      throw bundleError("PROFILE_REQUIRED", "Select a profile or set defaultProfile in the bundle");
+    }
+    if (typeof bundle.defaultProfile !== "string") {
+      throw bundleError("INVALID_BUNDLE", "Profile bundle defaultProfile must be a string");
+    }
+    name = bundle.defaultProfile;
+  }
+  const layers: { config?: string; overrides?: ReturnType<typeof parseOverrides> }[] = [];
+  const visited = new Set<string>();
+  while (true) {
+    if (!Object.hasOwn(profiles, name)) {
+      throw bundleError("UNKNOWN_PROFILE", `Unknown profile: ${name}`);
+    }
+    if (visited.has(name)) {
+      const chain = [...visited, name].map((profile) => JSON.stringify(profile)).join(" -> ");
+      throw bundleError("PROFILE_CYCLE", `Profile inheritance cycle: ${chain}`);
+    }
+    visited.add(name);
+    const profile = profiles[name];
+    if (!isObject(profile)) {
+      throw bundleError("INVALID_BUNDLE", `Profile ${JSON.stringify(name)} must be an object`);
+    }
+    const hasConfig = Object.hasOwn(profile, "config");
+    const hasParent = Object.hasOwn(profile, "extends");
+    const hasOverrides = Object.hasOwn(profile, "overrides");
+    for (const key of ["config", "extends"] as const) {
+      if (Object.hasOwn(profile, key) && (typeof profile[key] !== "string" || profile[key].trim() === "")) {
+        throw bundleError("INVALID_BUNDLE", `Profile ${JSON.stringify(name)} ${key} must be a non-empty string`);
+      }
+    }
+    if (!hasConfig && !hasParent && !hasOverrides) {
+      throw bundleError("INVALID_BUNDLE", `Profile ${JSON.stringify(name)} must have config, extends, or overrides`);
+    }
+    layers.push({
+      config: hasConfig ? profile.config as string : undefined,
+      overrides: hasOverrides ? parseOverrides(profile.overrides) : undefined,
+    });
+    if (!hasParent) break;
+    name = profile.extends as string;
+  }
+
+  let config: DebateConfig = {};
+  // Supplied fields replace inherited values wholesale, including participant
+  // lists in their original order. Omitted fields remain inherited.
+  for (const layer of layers.reverse()) {
+    if (layer.config !== undefined) {
+      const configPath = await resolveConfigPath(bundleDirectory, layer.config);
+      config = { ...config, ...parseDebateConfigOverlay(await readFile(configPath, "utf8")) };
+    }
+    if (layer.overrides) {
+      config = { ...config, ...layer.overrides.config };
+      if (layer.overrides.removeJudge) delete config.judge;
+    }
+  }
+  if (config.participants && config.participants.length < 2) {
+    throw new Error(`debate config: a debate needs at least 2 participants (got ${config.participants.length})`);
+  }
+  return config;
+}
