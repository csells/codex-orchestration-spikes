+test("lists profile names as JSON without resolving entries and rejects list mode conflicts", async () => {
+  await inTempDir(async (dir) => {
+    const bundlePath = join(dir, "bundle.json");
+    await writeFile(bundlePath, JSON.stringify({
+      version: 1,
+      defaultProfile: { ignored: true },
+      profiles: { z: null, A: { config: "missing.yaml" }, "\uE000": [], "\u{10000}": { extends: "z" } },
+    }));
+
+    const listed = await runCli(dir, ["--bundle", "bundle.json", "--list"]);
+    assert.deepEqual(listed, { code: 0, stdout: JSON.stringify(["A", "z", "\uE000", "\u{10000}"]) + "\n", stderr: "" });
+    await writeFile(bundlePath, JSON.stringify({ version: 1, profiles: {} }));
+    assert.deepEqual(await runCli(dir, ["--bundle", "bundle.json", "--list"]), {
+      code: 0, stdout: "[]\n", stderr: "",
+    });
+    for (const args of [
+      ["--bundle", "bundle.json", "--list", "--profile", "A"],
+      ["--bundle", "bundle.json", "--profile=", "--list"],
+      ["--bundle", "bundle.json", "--list", "--json"],
+      ["--bundle", "bundle.json", "--json", "--list"],
+    ]) {
+      const result = await runCli(dir, args);
+      assert.equal(result.code, 1);
+      assert.equal(result.stdout, "");
+      assert.notEqual(result.stderr, "");
+    }
+
+    await writeFile(bundlePath, "{");
+    const invalid = await runCli(dir, ["--bundle", "bundle.json", "--list"]);
+    assert.equal(invalid.code, 1);
+    assert.equal(invalid.stdout, "");
+    assert.match(invalid.stderr, /INVALID_BUNDLE/);
+  });
+});
