+test("listDebates filters the full catalog before paginating matching debates", async () => {
+  const root = await makeRoot();
+  try {
+    const unjudged = await debate(root, "debate-z");
+    await writeFile(join(unjudged, "final-report.md"), "report");
+
+    const resolved = await debate(root, "debate-y");
+    await writeFile(join(resolved, "respondeo.md"), "STATUS: RESOLVED");
+
+    const failed = await debate(root, "debate-x");
+    await writeFile(join(failed, "respondeo.md"), "Respondeo turn failed: timeout");
+    await writeFile(join(failed, "final-report.md"), "report");
+
+    const secondResolved = await debate(root, "debate-w");
+    await writeFile(join(secondResolved, "respondeo.md"), "STATUS: RESOLVED");
+
+    const needsInput = await debate(root, "debate-v");
+    await writeFile(join(needsInput, "respondeo.md"), "STATUS: NEEDS_INPUT");
+    await writeFile(join(needsInput, "final-report.md"), "report");
+
+    const unknown = await debate(root, "debate-u");
+    await writeFile(join(unknown, "respondeo.md"), "STATUS: resolved");
+
+    const ids = async (options?: Parameters<typeof listDebates>[1]) =>
+      (await listDebates(root, options)).map((entry) => entry.id);
+    const full = ["debate-z", "debate-y", "debate-x", "debate-w", "debate-v", "debate-u"];
+
+    assert.deepEqual(await ids(), full);
+    assert.deepEqual(await ids({ status: undefined, hasFinalReport: undefined }), full);
+    assert.deepEqual(await ids({ status: "unjudged" }), ["debate-z"]);
+    assert.deepEqual(await ids({ status: "resolved" }), ["debate-y", "debate-w"]);
+    assert.deepEqual(await ids({ status: "needs-input" }), ["debate-v"]);
+    assert.deepEqual(await ids({ status: "failed" }), ["debate-x"]);
+    assert.deepEqual(await ids({ status: "unknown" }), ["debate-u"]);
+    assert.deepEqual(await ids({ hasFinalReport: true }), ["debate-z", "debate-x", "debate-v"]);
+    assert.deepEqual(await ids({ hasFinalReport: false }), ["debate-y", "debate-w", "debate-u"]);
+    assert.deepEqual(await ids({ status: "needs-input", hasFinalReport: true }), ["debate-v"]);
+    assert.deepEqual(await ids({ status: "needs-input", hasFinalReport: false }), []);
+
+    // Status filtering produces y/w before applying limit and offset.
+    assert.deepEqual(await ids({ limit: 2, status: "resolved" }), ["debate-y", "debate-w"]);
+    assert.deepEqual(await ids({ offset: 1, limit: 2, status: "resolved" }), ["debate-w"]);
+    // Report filtering similarly precedes pagination: matching ids are z/x/v.
+    assert.deepEqual(await ids({ limit: 2, hasFinalReport: true }), ["debate-z", "debate-x"]);
+    assert.deepEqual(await ids({ offset: 1, limit: 2, hasFinalReport: true }), ["debate-x", "debate-v"]);
+    // Both filters apply as an AND to the full catalog before selecting the page.
+    assert.deepEqual(await ids({ limit: 1, status: "resolved", hasFinalReport: false }), ["debate-y"]);
+    assert.deepEqual(await ids({ offset: 1, limit: 1, status: "resolved", hasFinalReport: false }), ["debate-w"]);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
