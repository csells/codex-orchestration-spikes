+import { constants } from "node:fs";
+import { lstat, open, readdir } from "node:fs/promises";
+import { join, resolve } from "node:path";
+
+export type DeterminationStatus = "resolved" | "needs-input" | "failed" | "unknown";
+export type DebateArtifactKind = "transcript" | "determination" | "final-report";
+
+export type DebateEntry = {
+  id: string;
+  path: string;
+  hasTranscript: boolean;
+  hasFinalReport: boolean;
+  determination: string | null;
+  status: "unjudged" | DeterminationStatus;
+};
+
+export type ListDebatesOptions = {
+  offset?: number;
+  limit?: number;
+  /** Filters apply to the full catalog before offset and limit. */
+  status?: DebateEntry["status"];
+  hasFinalReport?: boolean;
+};
+
+const DEBATE_ID = /^debate-[A-Za-z0-9][A-Za-z0-9._-]*$/;
+const CATALOG_STATUSES = new Set(["unjudged", "resolved", "needs-input", "failed", "unknown"]);
+
+/** Catalog markers are strict; the debate engine's parser has separate semantics. */
+export function classifyDetermination(text: string): DeterminationStatus {
+  const firstLine = text.split(/\r\n?|\n/).map((line) => line.trim()).find(Boolean);
+  if (firstLine === "STATUS: RESOLVED") return "resolved";
+  if (firstLine === "STATUS: NEEDS_INPUT") return "needs-input";
+  if (firstLine?.startsWith("Respondeo turn failed:")) return "failed";
+  return "unknown";
+}
+
+function unsafePath(): Error & { code: string } {
+  return Object.assign(new Error("Cannot read through a symlink"), { code: "UNSAFE_PATH" });
+}
+
+async function readRegularArtifact(path: string): Promise<string | null> {
+  let file;
+  try {
+    const info = await lstat(path);
+    if (info.isSymbolicLink()) throw unsafePath();
+    if (!info.isFile()) return null;
+    // Refuse links even if the file changed after lstat. NONBLOCK prevents a
+    // replacement FIFO from hanging before the regular-file check.
+    file = await open(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+    if (!(await file.stat()).isFile()) return null;
+    return await file.readFile("utf8");
+  } catch (error) {
+    const code = (error as NodeJS.ErrnoException).code;
+    if (code === "ENOENT" || code === "ENOTDIR") return null;
+    if (code === "ELOOP") throw unsafePath();
+    throw error;
+  } finally {
+    await file?.close();
+  }
+}
+
+async function latestDetermination(path: string, rejectSymlinks = false): Promise<{ name: string; text: string } | null> {
+  const candidates: { name: string; version: bigint }[] = [];
+  for (const child of await readdir(path, { withFileTypes: true })) {
+    if (!child.isFile()) continue; // Excludes symlinks and all other nonregular files.
+    const match = /^respondeo(?:-([0-9]+))?\.md$/.exec(child.name);
+    if (!match || match[0] !== child.name) continue;
+    const version = BigInt(match[1] ?? "1");
+    if (version > 0n) candidates.push({ name: child.name, version });
+  }
+  // BigInt preserves numeric ordering even beyond Number.MAX_SAFE_INTEGER.
+  // Equal versions use ascending filename order as a deterministic tie-breaker.
+  candidates.sort((a, b) => a.version === b.version
+    ? (a.name < b.name ? -1 : a.name > b.name ? 1 : 0)
+    : a.version > b.version ? -1 : 1);
+
+  for (const candidate of candidates) {
+    try {
+      const text = await readRegularArtifact(join(path, candidate.name));
+      if (text !== null) return { name: candidate.name, text };
+    } catch (error) {
+      // Catalog scans ignore symlinks; explicit reads reject a selected file
+      // that became a symlink between enumeration and opening it.
+      if (rejectSymlinks || (error as NodeJS.ErrnoException).code !== "UNSAFE_PATH") throw error;
+    }
+  }
+  return null;
+}
+
+async function isRegularFile(path: string): Promise<boolean> {
+  try {
+    // lstat checks the artifact itself without following a file symlink.
+    return (await lstat(path)).isFile();
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return false;
+    throw error;
+  }
+}
+
+/** Read exact UTF-8 artifact text without following child or artifact symlinks. */
+export async function readDebateArtifact(root: string, id: string, kind: DebateArtifactKind): Promise<string | null> {
+  if (typeof id !== "string" || !DEBATE_ID.test(id)) {
+    throw Object.assign(new Error("id must be a debate directory basename"), { code: "INVALID_ID" });
+  }
+  if (kind !== "transcript" && kind !== "determination" && kind !== "final-report") {
+    throw Object.assign(new Error("Unknown artifact kind"), { code: "INVALID_QUERY" });
+  }
+  const path = join(resolve(root), id);
+  try {
+    const directory = await lstat(path);
+    if (directory.isSymbolicLink()) throw unsafePath();
+    if (!directory.isDirectory()) return null;
+    if (kind === "determination") {
+      // Use the catalog's regular-file selection, including its numeric ordering.
+      return (await latestDetermination(path, true))?.text ?? null;
+    }
+    return await readRegularArtifact(join(path, kind === "transcript" ? "debate.md" : "final-report.md"));
+  } catch (error) {
+    const code = (error as NodeJS.ErrnoException).code;
+    if (code === "ENOENT" || code === "ENOTDIR") return null;
+    throw error;
+  }
+}
+
+/**
+ * Filter the full catalog in descending ID order, then apply offset and limit.
+ * Omitted filters preserve every entry; never launch participants.
+ */
+export async function listDebates(root: string, options: ListDebatesOptions = {}): Promise<DebateEntry[]> {
+  const { offset = 0, limit, status, hasFinalReport } = options;
+  for (const [name, value] of [["offset", offset], ["limit", limit]] as const) {
+    if (value !== undefined && (!Number.isInteger(value) || value < 0)) {
+      throw Object.assign(new Error(`${name} must be a nonnegative integer`), { code: "INVALID_QUERY" });
+    }
+  }
+  if (status !== undefined && (typeof status !== "string" || !CATALOG_STATUSES.has(status))) {
+    throw Object.assign(new Error("status must be a catalog status"), { code: "INVALID_QUERY" });
+  }
+  if (hasFinalReport !== undefined && typeof hasFinalReport !== "boolean") {
+    throw Object.assign(new Error("hasFinalReport must be a boolean"), { code: "INVALID_QUERY" });
+  }
+  const absoluteRoot = resolve(root);
+  let children;
+  try {
+    children = await readdir(absoluteRoot, { withFileTypes: true });
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return [];
+    throw error;
+  }
+
+  // Dirent.isDirectory() excludes symlinks, including links to directories.
+  // IDs are ASCII, so reverse default string sorting gives descending code-point order.
+  const ids = children
+    .filter((child) => child.isDirectory() && DEBATE_ID.test(child.name))
+    .map((child) => child.name)
+    .sort()
+    .reverse();
+
+  const entries = await Promise.all(ids.map(async (id): Promise<DebateEntry> => {
+    const path = join(absoluteRoot, id);
+    const [hasTranscript, hasFinalReport, determination] = await Promise.all([
+      isRegularFile(join(path, "debate.md")),
+      isRegularFile(join(path, "final-report.md")),
+      latestDetermination(path),
+    ]);
+    return {
+      id, path, hasTranscript, hasFinalReport,
+      determination: determination?.name ?? null,
+      status: determination === null ? "unjudged" : classifyDetermination(determination.text),
+    };
+  }));
+
+  // Offset and limit count matching debates, not positions in the unfiltered catalog.
+  return entries
+    .filter((entry) =>
+      (status === undefined || entry.status === status) &&
+      (hasFinalReport === undefined || entry.hasFinalReport === hasFinalReport))
+    .slice(offset)
+    .slice(0, limit);
+}
