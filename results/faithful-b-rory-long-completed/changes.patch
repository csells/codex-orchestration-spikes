+test("listDebates reads metadata without modifying read-only artifacts", async () => {
+  const root = await makeRoot();
+  const path = await debate(root, "debate-read-only");
+  const transcript = join(path, "debate.md");
+  const report = join(path, "final-report.md");
+  const determination = join(path, "respondeo.md");
+  await writeFile(transcript, "immutable transcript");
+  await writeFile(report, "immutable report");
+  await writeFile(determination, "STATUS: RESOLVED\nimmutable determination");
+  await chmod(transcript, 0o444);
+  await chmod(report, 0o444);
+  await chmod(determination, 0o444);
+  await chmod(path, 0o555);
+  const [transcriptBefore, reportBefore] = await Promise.all([lstat(transcript), lstat(report)]);
+  try {
+    assert.deepEqual(await listDebates(root), [{
+      id: "debate-read-only",
+      path,
+      hasTranscript: true,
+      hasFinalReport: true,
+      determination: "respondeo.md",
+      status: "resolved",
+    }]);
+    assert.equal(await readFile(transcript, "utf8"), "immutable transcript");
+    assert.equal(await readFile(report, "utf8"), "immutable report");
+    assert.equal(await readFile(determination, "utf8"), "STATUS: RESOLVED\nimmutable determination");
+    assert.equal(await readDebateArtifact(root, "debate-read-only", "transcript"), "immutable transcript");
+    assert.equal(await readDebateArtifact(root, "debate-read-only", "final-report"), "immutable report");
+    assert.equal(await readDebateArtifact(root, "debate-read-only", "determination"), "STATUS: RESOLVED\nimmutable determination");
+    assert.equal((await lstat(determination)).mode & 0o777, 0o444);
+    const [transcriptAfter, reportAfter] = await Promise.all([lstat(transcript), lstat(report)]);
+    assert.equal(transcriptAfter.mode, transcriptBefore.mode);
+    assert.equal(reportAfter.mode, reportBefore.mode);
+  } finally {
+    await chmod(path, 0o755);
+    await rm(root, { recursive: true, force: true });
+  }
+});
