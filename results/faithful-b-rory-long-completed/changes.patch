+#!/usr/bin/env node
+// Standalone, read-only catalog entry point: no debate-engine or participant imports.
+import { listDebates, readDebateArtifact, type DebateArtifactKind, type ListDebatesOptions } from "./catalog.ts";
+
+const FLAGS = new Set(["--root", "--status", "--has-final-report", "--offset", "--limit", "--id", "--artifact"]);
+
+type Command =
+  | { mode: "list"; root: string; options: ListDebatesOptions }
+  | { mode: "artifact"; root: string; id: string; artifact: DebateArtifactKind };
+
+function invalidQuery(message: string): never {
+  throw Object.assign(new Error(message), { code: "INVALID_QUERY" });
+}
+
+function parseArguments(args: string[]): Command {
+  let root: string | undefined;
+  let id: string | undefined;
+  let artifact: string | undefined;
+  const options: ListDebatesOptions = {};
+  const seen = new Set<string>();
+  for (let i = 0; i < args.length; i++) {
+    const flag = args[i];
+    if (!FLAGS.has(flag)) invalidQuery(`Unknown argument: ${flag}`);
+    if (seen.has(flag)) invalidQuery(`Duplicate flag: ${flag}`);
+    seen.add(flag);
+    const value = args[++i];
+    if (value === undefined || value === "" || value.startsWith("--")) {
+      invalidQuery(`Missing value for ${flag}`);
+    }
+
+    switch (flag) {
+      case "--root":
+        root = value;
+        break;
+      case "--id":
+        id = value;
+        break;
+      case "--artifact":
+        artifact = value;
+        break;
+      case "--status":
+        // listDebates validates the status before accessing the filesystem.
+        options.status = value as ListDebatesOptions["status"];
+        break;
+      case "--has-final-report":
+        if (value !== "yes" && value !== "no") invalidQuery(`${flag} must be yes or no`);
+        options.hasFinalReport = value === "yes";
+        break;
+      case "--offset":
+      case "--limit": {
+        const number = Number(value);
+        if (/\D/.test(value) || !Number.isInteger(number)) {
+          invalidQuery(`${flag} must be a nonnegative integer`);
+        }
+        options[flag === "--offset" ? "offset" : "limit"] = number;
+        break;
+      }
+    }
+  }
+  if (root === undefined) invalidQuery("Missing required --root DIRECTORY");
+  if (id !== undefined || artifact !== undefined) {
+    if (id === undefined || artifact === undefined) invalidQuery("--id and --artifact must be provided together");
+    if (Object.keys(options).length > 0) {
+      invalidQuery("Artifact mode cannot combine with --status, --has-final-report, --offset, or --limit");
+    }
+    // readDebateArtifact validates the ID and artifact kind before filesystem access.
+    return { mode: "artifact", root, id, artifact: artifact as DebateArtifactKind };
+  }
+  return { mode: "list", root, options };
+}
+
+try {
+  const command = parseArguments(process.argv.slice(2));
+  // Emit nothing to stdout until validation and the requested read succeed.
+  if (command.mode === "artifact") {
+    const text = await readDebateArtifact(command.root, command.id, command.artifact);
+    if (text === null) {
+      console.error(`NOT_FOUND: ${command.artifact} artifact for ${command.id}`);
+      process.exitCode = 2;
+    } else {
+      process.stdout.write(text);
+    }
+  } else {
+    const entries = await listDebates(command.root, command.options);
+    console.log(JSON.stringify(entries));
+  }
+} catch (error) {
+  const code = (error as NodeJS.ErrnoException).code ?? "CATALOG_ERROR";
+  const message = error instanceof Error ? error.message : String(error);
+  console.error(`${code}: ${message}`);
+  process.exitCode = 1;
+}
