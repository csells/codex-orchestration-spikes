+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { execFile } from "node:child_process";
+import { mkdir, mkdtemp, rm, symlink, writeFile } from "node:fs/promises";
+import { promisify } from "node:util";
+import { join } from "node:path";
+
+const execFileAsync = promisify(execFile);
+const cliPath = join(process.cwd(), "src", "catalog-cli.ts");
+
+type CliResult = { code: number; stdout: string; stderr: string };
+
+async function runCli(args: string[]): Promise<CliResult> {
+  try {
+    const { stdout, stderr } = await execFileAsync(process.execPath, [cliPath, ...args], {
+      cwd: process.cwd(),
+    });
+    return { code: 0, stdout, stderr };
+  } catch (error) {
+    const result = error as NodeJS.ErrnoException & { stdout?: string; stderr?: string };
+    return { code: typeof result.code === "number" ? result.code : 1, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
+  }
+}
+
+async function makeRoot() {
+  return mkdtemp(join(process.cwd(), ".disputatio-catalog-cli-"));
+}
+
+async function debate(root: string, id: string) {
+  const path = join(root, id);
+  await mkdir(path, { recursive: true });
+  return path;
+}
+
+test("catalog CLI emits exact filtered metadata after full-catalog filtering and pagination", async () => {
+  const root = await makeRoot();
+  try {
+    const failed = await debate(root, "debate-z");
+    await writeFile(join(failed, "respondeo.md"), "Respondeo turn failed: timeout");
+    await writeFile(join(failed, "final-report.md"), "report");
+
+    const firstResolved = await debate(root, "debate-y");
+    await writeFile(join(firstResolved, "respondeo.md"), "STATUS: RESOLVED");
+
+    const unknown = await debate(root, "debate-x");
+    await writeFile(join(unknown, "respondeo.md"), "STATUS: resolved");
+
+    const secondResolved = await debate(root, "debate-w");
+    await writeFile(join(secondResolved, "respondeo.md"), "STATUS: RESOLVED");
+
+    const result = await runCli([
+      "--limit", "1",
+      "--has-final-report", "no",
+      "--root", root,
+      "--offset", "1",
+      "--status", "resolved",
+    ]);
+
+    assert.equal(result.code, 0, result.stderr);
+    assert.deepEqual(JSON.parse(result.stdout), [{
+      id: "debate-w",
+      path: secondResolved,
+      hasTranscript: false,
+      hasFinalReport: false,
+      determination: "respondeo.md",
+      status: "resolved",
+    }]);
+
+    const orderedResolved = await runCli(["--root", root, "--status", "resolved", "--has-final-report", "no"]);
+    assert.equal(orderedResolved.code, 0, orderedResolved.stderr);
+    assert.deepEqual(JSON.parse(orderedResolved.stdout).map((entry: { id: string }) => entry.id), ["debate-y", "debate-w"]);
+
+    const withReport = await runCli(["--has-final-report", "yes", "--root", root]);
+    assert.equal(withReport.code, 0, withReport.stderr);
+    assert.deepEqual(JSON.parse(withReport.stdout).map((entry: { id: string }) => entry.id), ["debate-z"]);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("catalog CLI returns an empty JSON array for a missing root", async () => {
+  const missingRoot = join(process.cwd(), ".disputatio-catalog-cli-missing-root");
+  const result = await runCli(["--root", missingRoot]);
+
+  assert.equal(result.code, 0, result.stderr);
+  assert.deepEqual(JSON.parse(result.stdout), []);
+});
+
+test("catalog CLI artifact mode preserves exact text and uses the catalog determination selection", async () => {
+  const root = await makeRoot();
+  const outside = await makeRoot();
+  try {
+    const path = await debate(root, "debate-artifacts");
+    const transcript = "\n  café\t";
+    const determination = "STATUS: NEEDS_INPUT\n  lower regular determination\n";
+    await writeFile(join(path, "debate.md"), transcript);
+    await writeFile(join(path, "final-report.md"), "");
+    await writeFile(join(path, "respondeo-2.md"), determination);
+    const outsideDetermination = join(outside, "respondeo-9.md");
+    await writeFile(outsideDetermination, "STATUS: RESOLVED\noutside");
+    await symlink(outsideDetermination, join(path, "respondeo-9.md"), "file");
+
+    const transcriptResult = await runCli(["--artifact", "transcript", "--root", root, "--id", "debate-artifacts"]);
+    assert.equal(transcriptResult.code, 0, transcriptResult.stderr);
+    assert.equal(transcriptResult.stdout, transcript);
+
+    const reportResult = await runCli(["--id", "debate-artifacts", "--artifact", "final-report", "--root", root]);
+    assert.equal(reportResult.code, 0, reportResult.stderr);
+    assert.equal(reportResult.stdout, "");
+
+    const determinationResult = await runCli(["--root", root, "--artifact", "determination", "--id", "debate-artifacts"]);
+    assert.equal(determinationResult.code, 0, determinationResult.stderr);
+    assert.equal(determinationResult.stdout, determination);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+    await rm(outside, { recursive: true, force: true });
+  }
+});
+
+test("catalog CLI artifact mode distinguishes not found from unsafe paths", async () => {
+  const root = await makeRoot();
+  const outside = await makeRoot();
+  try {
+    const empty = await debate(root, "debate-empty");
+    const outsideDebate = await debate(outside, "source");
+    await writeFile(join(outsideDebate, "debate.md"), "outside transcript");
+    await writeFile(join(outsideDebate, "respondeo-9.md"), "STATUS: RESOLVED");
+
+    for (const id of ["debate-missing", "debate-empty"]) {
+      const result = await runCli(["--root", root, "--id", id, "--artifact", "transcript"]);
+      assert.equal(result.code, 2, result.stderr);
+      assert.equal(result.stdout, "");
+      assert.match(result.stderr, /NOT_FOUND/i);
+    }
+
+    const onlySymlink = await debate(root, "debate-only-symlink-determination");
+    await symlink(join(outsideDebate, "respondeo-9.md"), join(onlySymlink, "respondeo-9.md"), "file");
+    const missingDetermination = await runCli(["--id", "debate-only-symlink-determination", "--artifact", "determination", "--root", root]);
+    assert.equal(missingDetermination.code, 2, missingDetermination.stderr);
+    assert.equal(missingDetermination.stdout, "");
+    assert.match(missingDetermination.stderr, /NOT_FOUND/i);
+
+    const linkedArtifacts = await debate(root, "debate-linked-artifacts");
+    await symlink(join(outsideDebate, "debate.md"), join(linkedArtifacts, "debate.md"), "file");
+    await symlink(join(outside, "missing-report.md"), join(linkedArtifacts, "final-report.md"), "file");
+    const unsafeArtifact = await runCli(["--root", root, "--id", "debate-linked-artifacts", "--artifact", "transcript"]);
+    assert.equal(unsafeArtifact.code, 1, unsafeArtifact.stderr);
+    assert.equal(unsafeArtifact.stdout, "");
+    assert.match(unsafeArtifact.stderr, /UNSAFE_PATH/i);
+    const unsafeReport = await runCli(["--root", root, "--id", "debate-linked-artifacts", "--artifact", "final-report"]);
+    assert.equal(unsafeReport.code, 1, unsafeReport.stderr);
+    assert.equal(unsafeReport.stdout, "");
+    assert.match(unsafeReport.stderr, /UNSAFE_PATH/i);
+
+    await symlink(outsideDebate, join(root, "debate-linked-directory"), "dir");
+    const unsafeDirectory = await runCli(["--artifact", "determination", "--id", "debate-linked-directory", "--root", root]);
+    assert.equal(unsafeDirectory.code, 1, unsafeDirectory.stderr);
+    assert.equal(unsafeDirectory.stdout, "");
+    assert.match(unsafeDirectory.stderr, /UNSAFE_PATH/i);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+    await rm(outside, { recursive: true, force: true });
+  }
+});
+
+test("catalog CLI validates artifact mode arguments and incompatible list filters", async () => {
+  const root = await makeRoot();
+  try {
+    const invalidArguments = [
+      ["--root", root, "--artifact", "transcript"],
+      ["--root", root, "--id", "debate-valid"],
+      ["--root", root, "--id", "not-a-debate", "--artifact", "transcript"],
+      ["--root", root, "--id", "debate-valid", "--artifact", "report"],
+      ["--root", root, "--id", "debate-valid", "--artifact", "transcript", "--status", "resolved"],
+      ["--root", root, "--id", "debate-valid", "--artifact", "transcript", "--has-final-report", "no"],
+      ["--root", root, "--id", "debate-valid", "--artifact", "transcript", "--offset", "0"],
+      ["--root", root, "--id", "debate-valid", "--artifact", "transcript", "--limit", "0"],
+    ];
+
+    for (const args of invalidArguments) {
+      const result = await runCli(args);
+      assert.equal(result.code, 1, `${args.join(" ")}\n${result.stderr}`);
+      assert.equal(result.stdout, "", `${args.join(" ")} unexpectedly wrote stdout`);
+      assert.match(result.stderr, /INVALID_(ID|QUERY)/i, `${args.join(" ")}\n${result.stderr}`);
+    }
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("catalog CLI rejects malformed flags and values without writing stdout", async () => {
+  const root = await makeRoot();
+  try {
+    const invalidArguments = [
+      [],
+      ["--root"],
+      ["--unknown", "value", "--root", root],
+      ["--root", root, "--has-final-report", "maybe"],
+      ["--root", root, "--offset", "one"],
+      ["--root", root, "--limit", "-1"],
+      ["--root", root, "--status", "RESOLVED"],
+      ["--root", root, "--status"],
+      ["--root", root, "--limit"],
+    ];
+
+    for (const args of invalidArguments) {
+      const result = await runCli(args);
+      assert.equal(result.code, 1, `${args.join(" ")}\n${result.stderr}`);
+      assert.equal(result.stdout, "", `${args.join(" ")} unexpectedly wrote stdout`);
+      assert.match(result.stderr, /INVALID_QUERY/i, `${args.join(" ")}\n${result.stderr}`);
+    }
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
