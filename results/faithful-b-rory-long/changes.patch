+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { chmod, lstat, mkdir, mkdtemp, readFile, rm, symlink, writeFile } from "node:fs/promises";
+import { join, relative, resolve } from "node:path";
+import { classifyDetermination, listDebates, readDebateArtifact } from "../src/catalog.ts";
+
+async function makeRoot() {
+  return mkdtemp(join(process.cwd(), ".disputatio-catalog-"));
+}
+
+async function debate(root: string, id: string) {
+  const path = join(root, id);
+  await mkdir(path, { recursive: true });
+  return path;
+}
+
+test("listDebates catalogs only immediate matching real directories in descending code-point order", async () => {
+  const root = await makeRoot();
+  try {
+    await debate(root, "debate-z");
+    await debate(root, "debate-Az");
+    await debate(root, "debate-10");
+    const complete = await debate(root, "debate-aa");
+    await writeFile(join(complete, "debate.md"), "transcript");
+    await writeFile(join(complete, "final-report.md"), "report");
+
+    await mkdir(join(root, "notes"));
+    await debate(join(root, "notes"), "debate-nested");
+    await mkdir(join(root, "debate-"));
+    await mkdir(join(root, "debate-.hidden"));
+    await mkdir(join(root, "Debate-wrong-case"));
+    await writeFile(join(root, "debate-file"), "not a directory");
+    const linkedTarget = await debate(root, "not-a-debate-target");
+    await symlink(linkedTarget, join(root, "debate-linked-page"), "dir");
+
+    const entries = await listDebates(root);
+
+    assert.deepEqual(entries, [
+      { id: "debate-z", path: join(root, "debate-z"), hasTranscript: false, hasFinalReport: false, determination: null, status: "unjudged" },
+      { id: "debate-aa", path: join(root, "debate-aa"), hasTranscript: true, hasFinalReport: true, determination: null, status: "unjudged" },
+      { id: "debate-Az", path: join(root, "debate-Az"), hasTranscript: false, hasFinalReport: false, determination: null, status: "unjudged" },
+      { id: "debate-10", path: join(root, "debate-10"), hasTranscript: false, hasFinalReport: false, determination: null, status: "unjudged" },
+    ]);
+    assert.deepEqual(await listDebates(root, undefined), entries);
+    assert.deepEqual(await listDebates(root, { offset: undefined, limit: undefined }), entries);
+    assert.deepEqual(await listDebates(root, { limit: 2 }), entries.slice(0, 2));
+    assert.deepEqual(await listDebates(root, { offset: 1, limit: 2 }), entries.slice(1, 3));
+    assert.deepEqual(await listDebates(root, { offset: 2 }), entries.slice(2));
+    assert.deepEqual(await listDebates(root, { offset: 0, limit: 0 }), []);
+    assert.deepEqual(await listDebates(root, { offset: 99 }), []);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("listDebates resolves a relative root and treats a missing root as empty", async () => {
+  const root = await makeRoot();
+  try {
+    await debate(root, "debate-relative");
+    const relativeRoot = relative(process.cwd(), root);
+
+    assert.deepEqual(await listDebates(relativeRoot), [
+      {
+        id: "debate-relative",
+        path: resolve(relativeRoot, "debate-relative"),
+        hasTranscript: false,
+        hasFinalReport: false,
+        determination: null,
+        status: "unjudged",
+      },
+    ]);
+    assert.deepEqual(await listDebates(join(root, "not-here")), []);
+
+    const fileRoot = join(root, "not-a-directory");
+    await writeFile(fileRoot, "file");
+    await assert.rejects(() => listDebates(fileRoot), { code: "ENOTDIR" });
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("listDebates rejects every invalid page field before looking up the root", async () => {
+  const missingRoot = join(process.cwd(), ".disputatio-catalog-missing-root");
+  const listWithUnknownOptions = listDebates as unknown as (root: string, options: unknown) => Promise<unknown>;
+  const invalidOptions: unknown[] = [
+    { offset: -1 }, { limit: -1 },
+    { offset: 1.5 }, { limit: 1.5 },
+    { offset: Number.NaN }, { limit: Number.NaN },
+    { offset: Number.POSITIVE_INFINITY }, { limit: Number.POSITIVE_INFINITY },
+    { offset: null }, { limit: null },
+    { offset: "1" }, { limit: "1" },
+    { offset: true }, { limit: false },
+    { offset: {} }, { limit: [] },
+    { status: "RESOLVED" }, { status: "not-a-status" },
+    { status: null }, { status: true }, { status: {} },
+    { hasFinalReport: "true" }, { hasFinalReport: null },
+    { hasFinalReport: 1 }, { hasFinalReport: {} },
+    { limit: 0, status: "resolved-ish" },
+    { limit: 0, hasFinalReport: "false" },
+  ];
+
+  for (const options of invalidOptions) {
+    await assert.rejects(() => listWithUnknownOptions(missingRoot, options), { code: "INVALID_QUERY" });
+  }
+});
+
+test("readDebateArtifact validates IDs and kinds before accessing a missing root", async () => {
+  const missingRoot = join(process.cwd(), ".disputatio-catalog-missing-artifact-root");
+  const readWithUnknownArguments = readDebateArtifact as unknown as (
+    root: string, id: unknown, kind: unknown,
+  ) => Promise<unknown>;
+
+  for (const id of ["debate-", "not-a-debate", "debate/a", "../debate-safe", "debate-💥"]) {
+    await assert.rejects(() => readWithUnknownArguments(missingRoot, id, "transcript"), { code: "INVALID_ID" });
+  }
+  for (const kind of ["", "report", "TRANSCRIPT", null, true, {}]) {
+    await assert.rejects(() => readWithUnknownArguments(missingRoot, "debate-valid", kind), { code: "INVALID_QUERY" });
+  }
+});
+
+test("readDebateArtifact returns exact regular artifacts and null for absent or nonregular paths", async () => {
+  const root = await makeRoot();
+  try {
+    const path = await debate(root, "debate-artifacts");
+    const transcript = "  transcript whitespace\r\n\n";
+    const report = "final report\n  still exact\n";
+    const prior = "STATUS: NEEDS_INPUT\nprior";
+    const latest = "\nSTATUS: RESOLVED\r\n latest determination \n";
+    await writeFile(join(path, "debate.md"), transcript);
+    await writeFile(join(path, "final-report.md"), report);
+    await writeFile(join(path, "respondeo.md"), prior);
+    await writeFile(join(path, "respondeo-2.md"), latest);
+
+    assert.equal((await listDebates(root))[0]?.determination, "respondeo-2.md");
+    assert.equal(await readDebateArtifact(root, "debate-artifacts", "transcript"), transcript);
+    assert.equal(await readDebateArtifact(root, "debate-artifacts", "final-report"), report);
+    assert.equal(await readDebateArtifact(root, "debate-artifacts", "determination"), latest);
+    assert.equal(await readDebateArtifact(root, "debate-missing", "transcript"), null);
+
+    const empty = await debate(root, "debate-empty");
+    assert.equal(await readDebateArtifact(root, "debate-empty", "transcript"), null);
+    assert.equal(await readDebateArtifact(root, "debate-empty", "final-report"), null);
+    assert.equal(await readDebateArtifact(root, "debate-empty", "determination"), null);
+    await mkdir(join(empty, "debate.md"));
+    await mkdir(join(empty, "final-report.md"));
+    await mkdir(join(empty, "respondeo-4.md"));
+    assert.equal(await readDebateArtifact(root, "debate-empty", "transcript"), null);
+    assert.equal(await readDebateArtifact(root, "debate-empty", "final-report"), null);
+    assert.equal(await readDebateArtifact(root, "debate-empty", "determination"), null);
+
+    await writeFile(join(root, "debate-file-instead-of-directory"), "not a directory");
+    assert.equal(await readDebateArtifact(root, "debate-file-instead-of-directory", "transcript"), null);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("readDebateArtifact rejects direct symlink traversal but skips symlink determinations", async () => {
+  const root = await makeRoot();
+  const outside = await makeRoot();
+  try {
+    const outsideDebate = await debate(outside, "source");
+    await writeFile(join(outsideDebate, "debate.md"), "outside transcript");
+    await writeFile(join(outsideDebate, "final-report.md"), "outside report");
+    await writeFile(join(outsideDebate, "respondeo-9.md"), "STATUS: RESOLVED\noutside determination");
+
+    const linkedArtifacts = await debate(root, "debate-linked-artifacts");
+    await symlink(join(outsideDebate, "debate.md"), join(linkedArtifacts, "debate.md"), "file");
+    await symlink(join(outside, "missing-report.md"), join(linkedArtifacts, "final-report.md"), "file");
+    await assert.rejects(() => readDebateArtifact(root, "debate-linked-artifacts", "transcript"), { code: "UNSAFE_PATH" });
+    await assert.rejects(() => readDebateArtifact(root, "debate-linked-artifacts", "final-report"), { code: "UNSAFE_PATH" });
+
+    await symlink(outsideDebate, join(root, "debate-linked-directory"), "dir");
+    for (const kind of ["transcript", "final-report", "determination"] as const) {
+      await assert.rejects(() => readDebateArtifact(root, "debate-linked-directory", kind), { code: "UNSAFE_PATH" });
+    }
+
+    const onlySymlink = await debate(root, "debate-only-symlink-determination");
+    await symlink(join(outsideDebate, "respondeo-9.md"), join(onlySymlink, "respondeo-9.md"), "file");
+    assert.equal(await readDebateArtifact(root, "debate-only-symlink-determination", "determination"), null);
+
+    const lowerRegular = await debate(root, "debate-regular-determination");
+    const lowerText = "STATUS: NEEDS_INPUT\nlower regular file\n";
+    await writeFile(join(lowerRegular, "respondeo-2.md"), lowerText);
+    await symlink(join(outsideDebate, "respondeo-9.md"), join(lowerRegular, "respondeo-9.md"), "file");
+    assert.equal((await listDebates(root)).find((entry) => entry.id === "debate-regular-determination")?.determination, "respondeo-2.md");
+    assert.equal(await readDebateArtifact(root, "debate-regular-determination", "determination"), lowerText);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+    await rm(outside, { recursive: true, force: true });
+  }
+});
