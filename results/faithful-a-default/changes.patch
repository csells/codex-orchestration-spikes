+test("CLI reports loader error codes on stderr and never emits partial YAML", async (t) => {
+  const { bundlePath, run } = await fixture(t);
+  const cases: [string, string[], string][] = [
+    ["{", [], "INVALID_BUNDLE"],
+    [JSON.stringify({ version: 1, profiles: {} }), [], "PROFILE_REQUIRED"],
+    [JSON.stringify({ version: 1, defaultProfile: "missing", profiles: {} }), [], "UNKNOWN_PROFILE"],
+    [JSON.stringify({ version: 1, profiles: {} }), ["--profile", "missing"], "UNKNOWN_PROFILE"],
+    [JSON.stringify({ version: 1, defaultProfile: "child", profiles: { child: { extends: "missing" } } }), [], "UNKNOWN_PROFILE"],
+    [JSON.stringify({ version: 1, defaultProfile: "loop", profiles: { loop: { extends: "loop" } } }), [], "PROFILE_CYCLE"],
+    [JSON.stringify({ version: 1, defaultProfile: "bad", profiles: { bad: { config: "../outside.yaml" } } }), [], "UNSAFE_CONFIG_PATH"],
+    [JSON.stringify({ version: 1, defaultProfile: "bad", profiles: { bad: { config: "missing.yaml" } } }), [], "ENOENT"],
+  ];
+  for (const [text, args, code] of cases) {
+    await writeFile(bundlePath, text);
+    const result = run(["--bundle", bundlePath, ...args]);
+    assert.equal(result.status, 1);
+    assert.equal(result.stdout, "");
+    assert.ok(result.stderr.includes(code), result.stderr);
+    assert.equal(await readFile(bundlePath, "utf8"), text);
+  }
+  const missing = run(["--bundle", "missing.json"]);
+  assert.equal(missing.status, 1);
+  assert.equal(missing.stdout, "");
+  assert.match(missing.stderr, /ENOENT/);
+});
