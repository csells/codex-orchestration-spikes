+const yaml = "rounds: 1\nrepo: ../repo\nparticipants:\n  - adapter: claude\n    model: sonnet\n  - adapter: codex\njudge:\n  adapter: claude\n  model: opus\n";
+
+async function fixture(t: { after: (fn: () => Promise<void>) => void }) {
+  const dir = await mkdtemp(join(tmpdir(), "disputatio-bundle-"));
+  t.after(() => rm(dir, { recursive: true, force: true }));
+  const bundlePath = join(dir, "bundle.json");
+  const configPath = join(dir, "configs", "fast.yaml");
+  await mkdir(join(dir, "configs"));
+  await writeFile(configPath, yaml);
+  await writeFile(bundlePath, JSON.stringify({ version: 1, profiles: { fast: { config: "configs/fast.yaml" } } }));
+  return { dir, bundlePath, configPath };
+}
+
+test("loads relative config paths from the bundle directory with independently owned results", async (t) => {
+  const { bundlePath, configPath } = await fixture(t);
+  const before = await Promise.all([readFile(bundlePath), readFile(configPath)]);
+  const first = await loadProfileBundle(bundlePath, "fast");
+  assert.deepEqual(first, parseDebateConfig(yaml));
+  first.rounds = 99;
+  first.participants![0].model = "changed";
+  first.participants!.push({ adapter: "pi" });
+  first.judge!.model = "changed";
+  const second = await loadProfileBundle(relative(process.cwd(), bundlePath), "fast");
+  assert.deepEqual(second, parseDebateConfig(yaml));
+  assert.deepEqual(await Promise.all([readFile(bundlePath), readFile(configPath)]), before);
