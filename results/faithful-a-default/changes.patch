+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtemp, mkdir, readFile, readdir, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { parseDebateConfig, serializeDebateConfig } from "../src/config.ts";
+
+const cli = fileURLToPath(new URL("../src/profile-cli.ts", import.meta.url));
+
+async function fixture(t: { after: (fn: () => Promise<void>) => void }) {
+  const dir = await mkdtemp(join(tmpdir(), "disputatio-profile-cli-"));
+  const bundlePath = join(dir, "bundle.json");
+  const configPath = join(dir, "base.yaml");
+  const marker = join(dir, "participant-ran");
+  t.after(async () => {
+    try {
+      await assert.rejects(readFile(marker), { code: "ENOENT" });
+    } finally {
+      await rm(dir, { recursive: true, force: true });
+    }
+  });
+  const binDir = join(dir, "bin");
+  await mkdir(binDir);
+  // PATH contains only local tripwires: any accidental participant invocation
+  // leaves evidence, and no installed agent CLI can run from these tests.
+  for (const name of ["claude", "codex", "agy", "pi", "copilot"]) {
+    await writeFile(join(binDir, name), '#!/bin/sh\nprintf invoked > "$PARTICIPANT_MARKER"\nexit 99\n', { mode: 0o755 });
+  }
+  const yaml = "# source formatting is not canonical\nrepo: ./repo\nrounds: 2\nparticipants:\n  - adapter: claude\n    model: sonnet\n  - adapter: codex\njudge:\n  adapter: pi\n";
+  await writeFile(configPath, yaml);
+  await writeFile(bundlePath, JSON.stringify({ version: 1, defaultProfile: "child", profiles: {
+    base: { config: "base.yaml" },
+    child: { extends: "base", overrides: {
+      rounds: 0, participants: [{ adapter: "codex", model: "updated" }, { adapter: "pi" }], judge: null,
+    } },
+  } }));
+  const run = (args: string[]) => {
+    const result = spawnSync(process.execPath, [cli, ...args], {
+      cwd: dir, encoding: "utf8", timeout: 5000,
+      env: { ...process.env, PATH: binDir, PARTICIPANT_MARKER: marker },
+    });
+    assert.ifError(result.error);
+    assert.equal(result.signal, null);
+    return result;
+  };
+  return { dir, bundlePath, configPath, yaml, run };
+}
+
+test("CLI renders default and explicit profiles as canonical reusable YAML without writes or participants", async (t) => {
+  const { dir, bundlePath, configPath, yaml, run } = await fixture(t);
