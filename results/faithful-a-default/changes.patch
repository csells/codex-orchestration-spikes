+test("CLI JSON renders resolved default and explicit configs without writes", async (t) => {
+  const { dir, bundlePath, configPath, yaml, run } = await fixture(t);
+  const before = await Promise.all([readFile(bundlePath), readFile(configPath)]);
+  const files = await readdir(dir, { recursive: true });
+  const result = run(["--json", "--bundle", bundlePath]);
+  assert.equal(result.status, 0);
+  assert.equal(result.stderr, "");
+  assert.deepEqual(JSON.parse(result.stdout), {
+    rounds: 0, repo: "./repo", participants: [{ adapter: "codex", model: "updated" }, { adapter: "pi" }],
+  });
+  const explicit = run(["--bundle", bundlePath, "--profile", "base", "--json"]);
+  assert.equal(explicit.status, 0);
+  assert.equal(explicit.stderr, "");
+  assert.deepEqual(JSON.parse(explicit.stdout), parseDebateConfig(yaml));
+  assert.deepEqual(await Promise.all([readFile(bundlePath), readFile(configPath)]), before);
+  assert.deepEqual(await readdir(dir, { recursive: true }), files);
+  // JSON rendering does not depend on the narrower YAML serializer.
+  await writeFile(configPath, "repo: '#literal'\n");
+  const literal = run(["--bundle", bundlePath, "--profile", "base", "--json"]);
+  assert.equal(literal.status, 0);
+  assert.equal(literal.stderr, "");
+  assert.deepEqual(JSON.parse(literal.stdout), { repo: "#literal" });
+});
