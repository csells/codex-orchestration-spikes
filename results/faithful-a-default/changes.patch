+  const files = await readdir(dir, { recursive: true });
+  const expected = {
+    rounds: 0, repo: "./repo", participants: [{ adapter: "codex", model: "updated" }, { adapter: "pi" }],
+  };
+  const rendered = run(["--bundle", "bundle.json"]);
+  assert.equal(rendered.status, 0);
+  assert.equal(rendered.stderr, "");
+  assert.deepEqual(parseDebateConfig(rendered.stdout), expected);
+  assert.equal(rendered.stdout, "rounds: 0\nrepo: ./repo\nparticipants:\n  - adapter: codex\n    model: updated\n  - adapter: pi\n");
+  const explicit = run(["--profile", "base", "--bundle", bundlePath]);
+  assert.equal(explicit.status, 0);
+  assert.equal(explicit.stderr, "");
+  assert.equal(explicit.stdout, serializeDebateConfig(parseDebateConfig(yaml)));
+  assert.deepEqual(await Promise.all([readFile(bundlePath), readFile(configPath)]), before);
+  assert.deepEqual(await readdir(dir, { recursive: true }), files);
+});
