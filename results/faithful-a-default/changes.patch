+#!/usr/bin/env node
+import { serializeDebateConfig } from "./config.ts";
+import { listProfiles, loadProfileBundle } from "./profile-bundle.ts";
+
+const usage = "usage: node src/profile-cli.ts --bundle FILE [--profile NAME] [--json]\n       node src/profile-cli.ts --bundle FILE --list";
+
+function parseArgs(args: string[]): { bundle: string; profile?: string; list: boolean; json: boolean } {
+  let bundle: string | undefined;
+  let profile: string | undefined;
+  let list = false;
+  let json = false;
+  for (let i = 0; i < args.length; i++) {
+    const flag = args[i];
+    if (flag === "--list" || flag === "--json") {
+      if (flag === "--list") {
+        if (list) throw new Error(`duplicate --list\n${usage}`);
+        list = true;
+      } else {
+        if (json) throw new Error(`duplicate --json\n${usage}`);
+        json = true;
+      }
+      continue;
+    }
+    if (flag !== "--bundle" && flag !== "--profile") {
+      throw new Error(`unknown argument: ${flag}\n${usage}`);
+    }
+    const value = args[++i];
+    if (!value || value.startsWith("--")) {
+      throw new Error(`${flag} requires a value\n${usage}`);
+    }
+    if (flag === "--bundle") {
+      if (bundle !== undefined) throw new Error(`duplicate --bundle\n${usage}`);
+      bundle = value;
+    } else {
+      if (profile !== undefined) throw new Error(`duplicate --profile\n${usage}`);
+      profile = value;
+    }
+  }
+  if (bundle === undefined) throw new Error(`--bundle is required\n${usage}`);
+  if (list && (profile !== undefined || json)) {
+    throw new Error(`--list cannot combine with --profile or --json\n${usage}`);
+  }
+  return { bundle, profile, list, json };
+}
+
+try {
+  const args = parseArgs(process.argv.slice(2));
+  // Finish loading and serializing before emitting anything, so failures leave
+  // stdout empty. This entry point only renders; it never launches a debate.
+  let output: string;
+  if (args.list) {
+    output = JSON.stringify(await listProfiles(args.bundle)) + "\n";
+  } else {
+    const config = await loadProfileBundle(args.bundle, args.profile);
+    output = args.json ? JSON.stringify(config, null, 2) + "\n" : serializeDebateConfig(config);
+  }
+  process.stdout.write(output);
+} catch (error) {
+  const code = error instanceof Error && "code" in error ? `[${String(error.code)}] ` : "";
+  const message = error instanceof Error ? error.message : String(error);
+  console.error(`${code}${message}`);
+  process.exitCode = 1;
+}
