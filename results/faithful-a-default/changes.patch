+import { readFile, realpath } from "node:fs/promises";
+import { dirname, isAbsolute, relative, resolve, sep } from "node:path";
+import { isDeepStrictEqual } from "node:util";
+import { parseDebateConfig, parseDebateConfigOverlay, serializeDebateConfig, type DebateConfig } from "./config.ts";
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function bundleError(code: "INVALID_BUNDLE" | "UNKNOWN_PROFILE" | "PROFILE_REQUIRED" | "PROFILE_CYCLE" | "UNSAFE_CONFIG_PATH", message: string): Error {
+  return Object.assign(new Error(message), { code });
+}
+
+function isWithin(directory: string, target: string): boolean {
+  const path = relative(directory, target);
+  return path !== ".." && !path.startsWith(`..${sep}`) && !isAbsolute(path);
+}
+
+async function resolveConfigPath(directory: string, configPath: string): Promise<string> {
+  const target = resolve(directory, configPath);
+  if (isAbsolute(configPath) || !isWithin(directory, target)) {
+    throw bundleError("UNSAFE_CONFIG_PATH", `config path must stay within the bundle directory: ${configPath}`);
+  }
+  const realTarget = await realpath(target);
+  if (!isWithin(directory, realTarget)) {
+    throw bundleError("UNSAFE_CONFIG_PATH", `config path resolves outside the bundle directory: ${configPath}`);
+  }
+  return realTarget;
+}
+
+function validateOverrideSpec(value: unknown): void {
+  if (!isObject(value)) throw new Error("participant and judge specs must be objects");
+  const stringKeys = ["adapter", "model", "bin", "effort"];
+  for (const [key, setting] of Object.entries(value)) {
+    if (key === "maxBudgetUsd") {
+      if (typeof setting !== "number" || !Number.isFinite(setting)) {
+        throw new Error("maxBudgetUsd must be a finite number");
+      }
+    } else if (!stringKeys.includes(key) || typeof setting !== "string") {
+      throw new Error(`unknown or invalid spec setting: ${key}`);
+    }
+  }
+  if (typeof value.adapter !== "string") throw new Error("spec requires an adapter");
+}
+
+function parseOverrides(value: unknown): { config: DebateConfig; removeJudge: boolean } {
+  try {
+    if (!isObject(value)) throw new Error("overrides must be an object");
+    for (const [key, setting] of Object.entries(value)) {
+      switch (key) {
+        case "rounds":
+        case "timeoutMinutes":
+          if (typeof setting !== "number" || !Number.isFinite(setting)) {
+            throw new Error(`${key} must be a finite number`);
+          }
+          break;
+        case "repo":
+          if (typeof setting !== "string") throw new Error("repo must be a string");
+          break;
+        case "participants":
+          if (!Array.isArray(setting)) throw new Error("participants must be an array");
+          setting.forEach(validateOverrideSpec);
+          break;
+        case "judge":
+          if (setting !== null) validateOverrideSpec(setting);
+          break;
+        default:
+          throw new Error(`unknown override key: ${key}`);
+      }
+    }
+    const config = { ...value };
+    const removeJudge = config.judge === null;
+    if (removeJudge) delete config.judge;
+    const parsed = parseDebateConfigOverlay(serializeDebateConfig(config as DebateConfig));
+    // The minimal YAML serializer cannot represent every JSON string. Refuse
+    // lossy round trips (quotes, escapes, newlines) instead of changing settings.
+    if (!isDeepStrictEqual(parsed, config)) throw new Error("override settings do not round-trip through config YAML");
+    return { config: parsed, removeJudge };
+  } catch (error) {
+    throw bundleError("INVALID_BUNDLE", `invalid overrides: ${error instanceof Error ? error.message : String(error)}`);
+  }
+}
+
+function overlayConfig(parent: DebateConfig, child: DebateConfig): DebateConfig {
+  // Every supplied value replaces its parent value, including the entire
+  // participant list in its supplied order. Absent keys inherit unchanged.
+  return { ...parent, ...child };
+}
+
+async function readBundleEnvelope(bundlePath: string) {
+  const absoluteBundlePath = await realpath(bundlePath);
+  const text = await readFile(absoluteBundlePath, "utf8");
+  let bundle: unknown;
+  try {
+    bundle = JSON.parse(text);
+  } catch {
+    throw bundleError("INVALID_BUNDLE", "profile bundle must contain valid JSON");
+  }
+  if (!isObject(bundle) || bundle.version !== 1) {
+    throw bundleError("INVALID_BUNDLE", "profile bundle must have version 1");
+  }
+  if (!isObject(bundle.profiles)) {
+    throw bundleError("INVALID_BUNDLE", "profile bundle profiles must be an object");
+  }
+  return { absoluteBundlePath, bundle, profiles: bundle.profiles };
+}
+
+// Compare Unicode code points rather than locale rules or UTF-16 code units.
+function compareProfileNames(a: string, b: string): number {
+  const left = Array.from(a);
+  const right = Array.from(b);
+  for (let i = 0; i < Math.min(left.length, right.length); i++) {
+    const difference = left[i].codePointAt(0)! - right[i].codePointAt(0)!;
+    if (difference !== 0) return difference;
+  }
+  return left.length - right.length;
+}
+
+export async function listProfiles(bundlePath: string): Promise<string[]> {
+  const { profiles } = await readBundleEnvelope(bundlePath);
+  return Object.keys(profiles).sort(compareProfileNames);
+}
+
+// Read and parse afresh on every load: inputs stay untouched and callers own
+// their entire configuration, including participant and judge objects.
+export async function loadProfileBundle(bundlePath: string, profileName?: string): Promise<DebateConfig> {
+  const { absoluteBundlePath, bundle, profiles } = await readBundleEnvelope(bundlePath);
+  if (profileName === undefined) {
+    if (!Object.hasOwn(bundle, "defaultProfile")) {
+      throw bundleError("PROFILE_REQUIRED", "select a profile or set defaultProfile in the bundle");
+    }
+    if (typeof bundle.defaultProfile !== "string") {
+      throw bundleError("INVALID_BUNDLE", "profile bundle defaultProfile must be a string");
+    }
+    profileName = bundle.defaultProfile;
+  }
+  const visiting = new Set<string>();
+  const chain: Record<string, unknown>[] = [];
+  let name = profileName;
+  // Walk iteratively so even a long inheritance chain or cycle cannot exhaust
+  // the call stack. Apply the collected profiles in parent-first order below.
+  while (true) {
+    if (!Object.hasOwn(profiles, name)) {
+      throw bundleError("UNKNOWN_PROFILE", `unknown profile: ${name}`);
+    }
+    if (visiting.has(name)) {
+      throw bundleError("PROFILE_CYCLE", `profile inheritance cycle at: ${name}`);
+    }
+    const profile = profiles[name];
+    if (!isObject(profile)) {
+      throw bundleError("INVALID_BUNDLE", `profile ${name} must be an object`);
+    }
+    const hasConfig = Object.hasOwn(profile, "config");
+    const hasParent = Object.hasOwn(profile, "extends");
+    const hasOverrides = Object.hasOwn(profile, "overrides");
+    if (!hasConfig && !hasParent && !hasOverrides) {
+      throw bundleError("INVALID_BUNDLE", `profile ${name} must have config, extends, or overrides`);
+    }
+    for (const key of ["config", "extends"] as const) {
+      if (Object.hasOwn(profile, key) && (typeof profile[key] !== "string" || profile[key].trim() === "")) {
+        throw bundleError("INVALID_BUNDLE", `profile ${name} ${key} must be a non-empty string`);
+      }
+    }
+    visiting.add(name);
+    chain.push(profile);
+    if (!hasParent) break;
+    name = profile.extends as string;
+  }
+
+  let result: DebateConfig = {};
+  for (const profile of chain.reverse()) {
+    const hasConfig = Object.hasOwn(profile, "config");
+    const hasParent = Object.hasOwn(profile, "extends");
+    const hasOverrides = Object.hasOwn(profile, "overrides");
+    if (hasConfig) {
+      const configPath = await resolveConfigPath(dirname(absoluteBundlePath), profile.config as string);
+      const configText = await readFile(configPath, "utf8");
+      result = hasParent || hasOverrides
+        ? overlayConfig(result, parseDebateConfigOverlay(configText))
+        : parseDebateConfig(configText);
+    }
+    if (hasOverrides) {
+      const overrides = parseOverrides(profile.overrides);
+      result = overlayConfig(result, overrides.config);
+      if (overrides.removeJudge) delete result.judge;
+    }
+  }
+
+  if (result.participants !== undefined && result.participants.length < 2) {
+    throw new Error(`debate config: a debate needs at least 2 participants (got ${result.participants.length})`);
+  }
+  return result;
+}
