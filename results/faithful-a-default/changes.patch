+    ["--list", "--json"], ["--json", "--list"]]) {
+    const result = run(["--bundle", bundlePath, ...flags]);
+    assert.equal(result.status, 1);
+    assert.equal(result.stdout, "");
+    assert.match(result.stderr, /--list cannot combine with --profile or --json/);
+  }
+});
