+test("CLI list validates the envelope and JSON rendering preserves loader errors", async (t) => {
+  const { bundlePath, run } = await fixture(t);
+  for (const text of ["{", '{"version":2,"profiles":{}}', '{"version":1,"profiles":[]}']) {
+    await writeFile(bundlePath, text);
+    const result = run(["--bundle", bundlePath, "--list"]);
+    assert.equal(result.status, 1);
+    assert.equal(result.stdout, "");
+    assert.match(result.stderr, /INVALID_BUNDLE/);
+    assert.equal(await readFile(bundlePath, "utf8"), text);
+  }
+  for (const [profile, code] of [[{ config: "../outside.yaml" }, "UNSAFE_CONFIG_PATH"],
+    [{ extends: "missing" }, "UNKNOWN_PROFILE"]] as const) {
+    await writeFile(bundlePath, JSON.stringify({ version: 1, defaultProfile: "bad", profiles: { bad: profile } }));
+    const result = run(["--bundle", bundlePath, "--json"]);
+    assert.equal(result.status, 1);
+    assert.equal(result.stdout, "");
+    assert.ok(result.stderr.includes(code), result.stderr);
+  }
+});
