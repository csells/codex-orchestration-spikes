+import { readFile, realpath } from "node:fs/promises";
+import { dirname, isAbsolute, relative, resolve, sep } from "node:path";
+import { isDeepStrictEqual } from "node:util";
+import { parseDebateConfigOverlay, serializeDebateConfig, type DebateConfig } from "./config.ts";
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function bundleError(
+  code: "INVALID_BUNDLE" | "UNKNOWN_PROFILE" | "PROFILE_REQUIRED" | "PROFILE_CYCLE" | "UNSAFE_CONFIG_PATH",
+  message: string,
+): Error {
+  return Object.assign(new Error(message), { code });
+}
+
+function validateOverrideSpec(value: unknown): void {
+  if (!isObject(value) || typeof value.adapter !== "string") {
+    throw bundleError("INVALID_BUNDLE", "Override participant and judge specs must be objects with an adapter");
+  }
+  for (const [key, field] of Object.entries(value)) {
+    const valid = key === "maxBudgetUsd"
+      ? typeof field === "number" && Number.isFinite(field)
+      : ["adapter", "model", "bin", "effort"].includes(key) && typeof field === "string";
+    if (!valid) throw bundleError("INVALID_BUNDLE", `Invalid override spec field: ${key}`);
+  }
+}
+
+function parseOverrides(value: unknown): { config: DebateConfig; removeJudge: boolean } {
+  if (!isObject(value)) throw bundleError("INVALID_BUNDLE", "Profile overrides must be an object");
+  // The serializer intentionally emits only supported fields. Check the JSON
+  // shape first so unknown keys and wrong types cannot disappear or be coerced.
+  for (const [key, field] of Object.entries(value)) {
+    switch (key) {
+      case "rounds":
+      case "timeoutMinutes":
+        if (typeof field !== "number" || !Number.isFinite(field)) {
+          throw bundleError("INVALID_BUNDLE", `Override ${key} must be a finite number`);
+        }
+        break;
+      case "repo":
+        if (typeof field !== "string") throw bundleError("INVALID_BUNDLE", "Override repo must be a string");
+        break;
+      case "participants":
+        if (!Array.isArray(field)) throw bundleError("INVALID_BUNDLE", "Override participants must be an array");
+        for (const spec of field) validateOverrideSpec(spec);
+        break;
+      case "judge":
+        if (field !== null) validateOverrideSpec(field);
+        break;
+      default:
+        throw bundleError("INVALID_BUNDLE", `Unknown override key: ${key}`);
+    }
+  }
+  const removeJudge = value.judge === null;
+  const candidate = { ...value };
+  if (removeJudge) delete candidate.judge;
+  try {
+    const config = parseDebateConfigOverlay(serializeDebateConfig(candidate as DebateConfig));
+    // The minimal YAML format cannot represent every JSON string losslessly.
+    if (!isDeepStrictEqual(config, candidate)) {
+      throw new Error("Override values cannot be represented losslessly by the config format");
+    }
+    return { config, removeJudge };
+  } catch (error) {
+    throw bundleError("INVALID_BUNDLE", `Invalid profile overrides: ${(error as Error).message}`);
+  }
+}
+
+function overlayConfig(parent: DebateConfig, child: DebateConfig): DebateConfig {
+  // Every supplied field replaces its inherited value, including the entire
+  // participants list in its original order. Only omitted fields inherit.
+  return { ...parent, ...child };
+}
+
+function isWithinDirectory(directory: string, target: string): boolean {
+  const pathFromDirectory = relative(directory, target);
+  return pathFromDirectory !== ".."
+    && !pathFromDirectory.startsWith(`..${sep}`)
+    && !isAbsolute(pathFromDirectory);
+}
+
+async function resolveConfigPath(bundleDirectory: string, configPath: string): Promise<string> {
+  const target = resolve(bundleDirectory, configPath);
+  if (isAbsolute(configPath) || !isWithinDirectory(bundleDirectory, target)) {
+    throw bundleError("UNSAFE_CONFIG_PATH", `Config path must stay relative to the bundle directory: ${configPath}`);
+  }
+  const realTarget = await realpath(target);
+  if (!isWithinDirectory(bundleDirectory, realTarget)) {
+    throw bundleError("UNSAFE_CONFIG_PATH", `Config path resolves outside the bundle directory: ${configPath}`);
+  }
+  // Read the checked real path, not the original symlink path.
+  return realTarget;
+}
+
+async function readBundleEnvelope(bundlePath: string) {
+  const realBundlePath = await realpath(bundlePath);
+  const bundleDirectory = dirname(realBundlePath);
+  const text = await readFile(realBundlePath, "utf8");
+  let bundle: unknown;
+  try {
+    bundle = JSON.parse(text);
+  } catch {
+    throw bundleError("INVALID_BUNDLE", `Invalid JSON in profile bundle: ${bundlePath}`);
+  }
+  if (!isObject(bundle) || bundle.version !== 1 || !isObject(bundle.profiles)) {
+    throw bundleError("INVALID_BUNDLE", "Profile bundle must have version 1 and a profiles object");
+  }
+  return { bundle, profiles: bundle.profiles, bundleDirectory };
+}
+
+function compareProfileNames(left: string, right: string): number {
+  // JavaScript's default sort compares UTF-16 units, not Unicode code points.
+  const leftPoints = Array.from(left, (char) => char.codePointAt(0)!);
+  const rightPoints = Array.from(right, (char) => char.codePointAt(0)!);
+  for (let i = 0; i < Math.min(leftPoints.length, rightPoints.length); i++) {
+    if (leftPoints[i] !== rightPoints[i]) return leftPoints[i] - rightPoints[i];
+  }
+  return leftPoints.length - rightPoints.length;
+}
+
+export async function listProfiles(bundlePath: string): Promise<string[]> {
+  const { profiles } = await readBundleEnvelope(bundlePath);
+  // Listing validates only the envelope; profile contents are resolved on load.
+  return Object.keys(profiles).sort(compareProfileNames);
+}
+
+export async function loadProfileBundle(bundlePath: string, profileName?: string): Promise<DebateConfig> {
+  const { bundle, profiles, bundleDirectory } = await readBundleEnvelope(bundlePath);
+  if (profileName === undefined) {
+    if (!Object.hasOwn(bundle, "defaultProfile")) {
+      throw bundleError("PROFILE_REQUIRED", "Select a profile or set defaultProfile in the bundle");
+    }
+    if (typeof bundle.defaultProfile !== "string") {
+      throw bundleError("INVALID_BUNDLE", "Bundle defaultProfile must be a profile name string");
+    }
+    profileName = bundle.defaultProfile;
+  }
+  const visiting = new Set<string>();
+  const chain: Record<string, unknown>[] = [];
+  // Discover the parent chain iteratively so even long chains and cycles cannot
+  // overflow the call stack. Only the selected profile's ancestry is inspected.
+  let name: string | undefined = profileName;
+  while (name !== undefined) {
+    if (!Object.hasOwn(profiles, name)) {
+      throw bundleError("UNKNOWN_PROFILE", `Unknown profile: ${name}`);
+    }
+    if (visiting.has(name)) {
+      throw bundleError("PROFILE_CYCLE", `Profile inheritance cycle: ${[...visiting, name].join(" -> ")}`);
+    }
+    const profile = profiles[name];
+    if (!isObject(profile)) {
+      throw bundleError("INVALID_BUNDLE", `Profile ${name} must be an object`);
+    }
+    const hasConfig = Object.hasOwn(profile, "config");
+    const hasParent = Object.hasOwn(profile, "extends");
+    const hasOverrides = Object.hasOwn(profile, "overrides");
+    if ((!hasConfig && !hasParent && !hasOverrides)
+      || (hasConfig && (typeof profile.config !== "string" || profile.config.trim() === ""))
+      || (hasParent && (typeof profile.extends !== "string" || profile.extends.trim() === ""))) {
+      throw bundleError("INVALID_BUNDLE", `Profile ${name} must have overrides, a non-empty config path, or an extends name`);
+    }
+    visiting.add(name);
+    chain.push(profile);
+    name = hasParent ? profile.extends as string : undefined;
+  }
+
+  // No cache or writes: every load owns its entire resolved configuration.
+  // Apply ancestors first, then each child's YAML and inline overrides.
+  let config: DebateConfig = {};
+  for (const profile of chain.reverse()) {
+    if (Object.hasOwn(profile, "config")) {
+      const configPath = await resolveConfigPath(bundleDirectory, profile.config as string);
+      config = overlayConfig(config, parseDebateConfigOverlay(await readFile(configPath, "utf8")));
+    }
+    if (Object.hasOwn(profile, "overrides")) {
+      const overrides = parseOverrides(profile.overrides);
+      config = overlayConfig(config, overrides.config);
+      if (overrides.removeJudge) delete config.judge;
+    }
+  }
+
+  if (config.participants && config.participants.length < 2) {
+    throw new Error(`debate config: a debate needs at least 2 participants (got ${config.participants.length})`);
+  }
+  return config;
+}
