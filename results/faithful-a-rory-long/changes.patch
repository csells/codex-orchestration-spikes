+  // A UTF-16 sort puts U+10000 before U+E000. The public listing is instead
+  // ordered by Unicode scalar value, so BMP private-use precedes U+10000.
+  const expected = ["A", "a", "z", "\uE000", "\u{10000}"];
+  const first = await listProfiles(bundlePath);
