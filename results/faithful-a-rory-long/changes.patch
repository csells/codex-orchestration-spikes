+test("loads config relative to the bundle, preserves inputs, and owns each result", async (t) => {
+  const { configPath, bundlePath } = await fixture(t);
+  const originalBundle = await readFile(bundlePath);
+  const originalConfig = await readFile(configPath);
+  const first = await loadProfileBundle(relative(process.cwd(), bundlePath), "fast");
+  assert.deepEqual(first, parseDebateConfig(yaml));
+  first.rounds = 99;
+  first.participants![0].model = "changed";
+  first.participants!.push({ adapter: "pi" });
+  first.judge!.adapter = "codex";
+  assert.deepEqual(await loadProfileBundle(bundlePath, "fast"), parseDebateConfig(yaml));
+  assert.deepEqual(await readFile(bundlePath), originalBundle);
+  assert.deepEqual(await readFile(configPath), originalConfig);
