+import { execFile } from "node:child_process";
+import assert from "node:assert/strict";
+import { mkdtemp, mkdir, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { test, type TestContext } from "node:test";
+import { promisify } from "node:util";
+import { fileURLToPath } from "node:url";
+import { parseDebateConfig, serializeDebateConfig } from "../src/config.ts";
+import { loadProfileBundle } from "../src/profile-bundle.ts";
+
+const execFileAsync = promisify(execFile);
+const root = join(dirname(fileURLToPath(import.meta.url)), "..");
+const profileCli = join(root, "src", "profile-cli.ts");
+
+type CliResult = { exitCode: number; stdout: string; stderr: string };
+
+async function runProfileCli(args: string[]): Promise<CliResult> {
+  try {
+    const { stdout, stderr } = await execFileAsync(process.execPath, [profileCli, ...args], {
+      cwd: root,
+      encoding: "utf8",
+    });
+    return { exitCode: 0, stdout, stderr };
+  } catch (error) {
+    const result = error as Error & { code?: number; stdout?: string; stderr?: string };
+    return {
+      exitCode: typeof result.code === "number" ? result.code : 1,
+      stdout: result.stdout ?? "",
+      stderr: result.stderr ?? "",
+    };
+  }
+}
+
+async function fixture(t: TestContext) {
+  const dir = await mkdtemp(join(tmpdir(), "disputatio-profile-cli-"));
+  t.after(() => rm(dir, { recursive: true, force: true }));
+  const configs = join(dir, "configs");
+  const bundlePath = join(dir, "bundle.json");
+  const configPath = join(configs, "default.yaml");
+  const alternatePath = join(configs, "alternate.yaml");
+  const invalidYamlPath = join(configs, "invalid.yaml");
+  const sentinelPath = join(dir, "participant-sentinel");
+  const sentinelMarker = join(dir, "participant-was-invoked");
+  await mkdir(configs);
+  // If the profile command ever starts a participant, this harmless executable leaves
+  // evidence behind. Rendering a profile must never invoke it.
+  await writeFile(sentinelPath, `#!/bin/sh\nprintf invoked > ${sentinelMarker}\nexit 91\n`, { mode: 0o755 });
+  await writeFile(configPath, `rounds: 2
+timeoutMinutes: 5
+repo: ./default-repo
+participants:
+  - adapter: claude
+    model: default-model
+    bin: ${sentinelPath}
+  - adapter: codex
+    bin: ${sentinelPath}
+judge:
+  adapter: pi
+`);
+  await writeFile(alternatePath, `rounds: 7
+participants:
+  - adapter: agy
+    model: alternate-model
+  - adapter: copilot-cli
+`);
+  await writeFile(invalidYamlPath, "unknown: key\n");
+  await writeFile(bundlePath, JSON.stringify({
+    version: 1,
+    defaultProfile: "default",
+    profiles: {
+      default: { config: "configs/default.yaml" },
+      alternate: { config: "configs/alternate.yaml" },
+      cycle: { extends: "cycle" },
+      missingConfig: { config: "configs/not-found.yaml" },
+      unsafe: { config: "../outside.yaml" },
+      invalidYaml: { config: "configs/invalid.yaml" },
+    },
+  }));
+  return { bundlePath, configPath, alternatePath, invalidYamlPath, sentinelMarker };
+}
+
+function assertFailure(result: CliResult, diagnostic: RegExp, code?: string): void {
+  assert.equal(result.exitCode, 1, result.stderr);
+  assert.equal(result.stdout, "", "failed commands must not write YAML to stdout");
+  assert.match(result.stderr, diagnostic);
+  if (code) assert.match(result.stderr, new RegExp(`\\b${code}\\b`));
+}
+
+test("profile CLI renders the selected or default profile exactly, regardless of flag order", async (t) => {
+  const { bundlePath, configPath, alternatePath, invalidYamlPath, sentinelMarker } = await fixture(t);
+  const originals = await Promise.all([bundlePath, configPath, alternatePath, invalidYamlPath].map((path) => readFile(path)));
+
+  const defaultResult = await runProfileCli(["--bundle", bundlePath]);
+  const expectedDefault = await loadProfileBundle(bundlePath);
+  assert.equal(defaultResult.exitCode, 0, defaultResult.stderr);
+  assert.equal(defaultResult.stderr, "");
+  assert.equal(defaultResult.stdout, serializeDebateConfig(expectedDefault));
+  assert.deepEqual(parseDebateConfig(defaultResult.stdout), expectedDefault);
+
+  const explicitResult = await runProfileCli(["--profile", "alternate", "--bundle", bundlePath]);
+  const expectedAlternate = await loadProfileBundle(bundlePath, "alternate");
+  assert.equal(explicitResult.exitCode, 0, explicitResult.stderr);
+  assert.equal(explicitResult.stderr, "");
+  assert.equal(explicitResult.stdout, serializeDebateConfig(expectedAlternate));
+  assert.deepEqual(parseDebateConfig(explicitResult.stdout), expectedAlternate);
+  assert.notEqual(explicitResult.stdout, defaultResult.stdout, "--profile must override defaultProfile");
+
+  await assert.rejects(readFile(sentinelMarker), { code: "ENOENT" });
+  assert.deepEqual(
+    await Promise.all([bundlePath, configPath, alternatePath, invalidYamlPath].map((path) => readFile(path))),
+    originals,
+    "rendering profiles must leave bundle and YAML inputs untouched",
+  );
+});
