+#!/usr/bin/env node
+// Render a bundle profile for use with Disputatio's normal --config option.
+import { serializeDebateConfig } from "./config.ts";
+import { listProfiles, loadProfileBundle } from "./profile-bundle.ts";
+
+function argumentError(message: string): Error {
+  return new Error(`${message}\nUsage: node src/profile-cli.ts --bundle FILE [--profile NAME] [--json]\n       node src/profile-cli.ts --bundle FILE --list`);
+}
+
+function parseArgs(args: string[]): { bundlePath: string; profileName?: string; list: boolean; json: boolean } {
+  let bundlePath: string | undefined;
+  let profileName: string | undefined;
+  let list = false;
+  let json = false;
+  for (let i = 0; i < args.length; i++) {
+    const flag = args[i];
+    if (flag === "--list") {
+      if (list) throw argumentError("Repeated --list argument");
+      list = true;
+      continue;
+    }
+    if (flag === "--json") {
+      if (json) throw argumentError("Repeated --json argument");
+      json = true;
+      continue;
+    }
+    if (flag !== "--bundle" && flag !== "--profile") {
+      throw argumentError(`Unknown argument: ${flag}`);
+    }
+    const value = args[++i];
+    if (!value || value.startsWith("-")) {
+      throw argumentError(`Missing value for ${flag}`);
+    }
+    if (flag === "--bundle") {
+      if (bundlePath !== undefined) throw argumentError("Repeated --bundle argument");
+      bundlePath = value;
+    } else {
+      if (profileName !== undefined) throw argumentError("Repeated --profile argument");
+      profileName = value;
+    }
+  }
+  if (bundlePath === undefined) throw argumentError("Missing required --bundle FILE argument");
+  if (list && (profileName !== undefined || json)) {
+    throw argumentError("--list cannot be combined with --profile or --json");
+  }
+  return { bundlePath, profileName, list, json };
+}
+
+try {
+  const { bundlePath, profileName, list, json } = parseArgs(process.argv.slice(2));
+  let output: string;
+  if (list) {
+    output = JSON.stringify(await listProfiles(bundlePath)) + "\n";
+  } else {
+    const config = await loadProfileBundle(bundlePath, profileName);
+    output = json ? JSON.stringify(config, null, 2) + "\n" : serializeDebateConfig(config);
+  }
+  // Complete loading and serialization before emitting anything to stdout.
+  process.stdout.write(output);
+} catch (error) {
+  const message = error instanceof Error ? error.message : String(error);
+  const code = error !== null && typeof error === "object" && "code" in error
+    ? `${String(error.code)}: `
+    : "";
+  console.error(`profile-cli: ${code}${message}`);
+  process.exitCode = 1;
+}
