+test("readDebateArtifact validates IDs and kinds before filesystem lookup", async () => {
+  const { base, root } = await fixture();
+  try {
+    const invalidIds = ["", "debate-", "debate-_invalid", "other", "debate/a", "../debate-a", "/tmp/debate-a", "debate-a!"];
+    for (const id of invalidIds) {
+      await assertErrorCode(() => readDebateArtifact(join(base, "missing"), id, "transcript"), "INVALID_ID");
+    }
+    for (const kind of ["report", "", null, true] as unknown[]) {
+      await assertErrorCode(() => readDebateArtifact(join(base, "missing"), "debate-valid", kind as never), "INVALID_QUERY");
+    }
+    await assertErrorCode(() => readDebateArtifact(join(base, "missing"), "../bad", "report" as never), "INVALID_ID");
+    assert.equal(await readDebateArtifact(root, "debate-valid", "transcript"), null);
+  } finally {
+    await rm(base, { recursive: true, force: true });
+  }
+});
