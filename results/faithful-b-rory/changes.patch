+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { execFile } from "node:child_process";
+import { mkdir, mkdtemp, readFile, readdir, readlink, rm, symlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { promisify } from "node:util";
+import { fileURLToPath } from "node:url";
+import type { DebateEntry as Entry } from "../src/catalog.ts";
+
+const execFileAsync = promisify(execFile);
+const cli = fileURLToPath(new URL("../src/catalog-cli.ts", import.meta.url));
+
+async function fixture(): Promise<{ base: string; root: string; bin: string }> {
+  const base = await mkdtemp(join(tmpdir(), "disputatio-catalog-cli-"));
+  const root = join(base, "catalog");
+  const bin = join(base, "empty-bin");
+  await Promise.all([mkdir(root), mkdir(bin)]);
+  return { base, root, bin };
+}
+
+async function run(bin: string, ...args: string[]): Promise<{ stdout: string; stderr: string }> {
+  return execFileAsync(process.execPath, [cli, ...args], {
+    env: { ...process.env, PATH: bin },
+  });
+}
+
+async function assertCliError(bin: string, args: string[], marker = "INVALID_QUERY", exitCode = 1): Promise<void> {
+  await assert.rejects(() => run(bin, ...args), (error: unknown) => {
+    const result = error as { code?: unknown; stdout?: unknown; stderr?: unknown };
+    assert.equal(result.code, exitCode);
+    assert.equal(result.stdout, "");
+    assert.match(String(result.stderr), new RegExp(marker));
+    return true;
+  });
+}
+
+test("catalog CLI emits complete JSON entries and filters before offset/limit with flags in any order", async () => {
+  const { base, root, bin } = await fixture();
+  try {
+    const z = join(root, "debate-z");
+    const y = join(root, "debate-y");
+    const x = join(root, "debate-x");
+    const w = join(root, "debate-w");
+    await Promise.all([mkdir(z), mkdir(y), mkdir(x), mkdir(w)]);
+    await Promise.all([
+      writeFile(join(z, "debate.md"), "z transcript"),
+      writeFile(join(z, "respondeo.md"), "STATUS: RESOLVED"),
+      writeFile(join(z, "final-report.md"), "z report"),
+      writeFile(join(y, "respondeo.md"), "STATUS: NEEDS_INPUT"),
+      writeFile(join(x, "respondeo.md"), "STATUS: RESOLVED"),
+      writeFile(join(x, "final-report.md"), "x report"),
+      writeFile(join(w, "final-report.md"), "w report"),
+    ]);
+
+    const full = await run(bin, "--root", root);
+    assert.equal(full.stderr, "");
+    assert.deepEqual(JSON.parse(full.stdout) as Entry[], [
+      { id: "debate-z", path: z, hasTranscript: true, hasFinalReport: true, determination: "respondeo.md", status: "resolved" },
+      { id: "debate-y", path: y, hasTranscript: false, hasFinalReport: false, determination: "respondeo.md", status: "needs-input" },
+      { id: "debate-x", path: x, hasTranscript: false, hasFinalReport: true, determination: "respondeo.md", status: "resolved" },
+      { id: "debate-w", path: w, hasTranscript: false, hasFinalReport: true, determination: null, status: "unjudged" },
+    ]);
+
+    const filtered = await run(
+      bin,
+      "--limit", "1",
+      "--root", root,
+      "--has-final-report", "yes",
+      "--status", "resolved",
+      "--offset", "1",
+    );
+    assert.equal(filtered.stderr, "");
+    assert.deepEqual(JSON.parse(filtered.stdout) as Entry[], [
+      { id: "debate-x", path: x, hasTranscript: false, hasFinalReport: true, determination: "respondeo.md", status: "resolved" },
+    ]);
+
+    const statusOnly = await run(bin, "--status", "resolved", "--root", root, "--offset", "1");
+    assert.deepEqual((JSON.parse(statusOnly.stdout) as Entry[]).map((entry) => entry.id), ["debate-x"]);
+    const withoutReport = await run(bin, "--has-final-report", "no", "--root", root);
+    assert.deepEqual((JSON.parse(withoutReport.stdout) as Entry[]).map((entry) => entry.id), ["debate-y"]);
+  } finally {
+    await rm(base, { recursive: true, force: true });
+  }
+});
+
+test("catalog CLI returns [] for a missing root and a valid zero limit", async () => {
+  const { base, root, bin } = await fixture();
+  try {
+    assert.deepEqual(JSON.parse((await run(bin, "--root", join(base, "missing"))).stdout), []);
+    assert.deepEqual(JSON.parse((await run(bin, "--limit", "0", "--root", root)).stdout), []);
+  } finally {
+    await rm(base, { recursive: true, force: true });
+  }
+});
+
+test("catalog CLI rejects malformed flags and query values without stdout", async () => {
+  const { base, root, bin } = await fixture();
+  try {
+    await assertCliError(bin, []);
+    await assertCliError(bin, ["--limit", "0"]);
+    await assertCliError(bin, ["--root", root, "unexpected"]);
+    await assertCliError(bin, ["--unknown", "x", "--root", root]);
+    await assertCliError(bin, ["--root"]);
+    await assertCliError(bin, ["--root", "--limit", "1"]);
+    await assertCliError(bin, ["--root", root, "--root", root]);
+    await assertCliError(bin, ["--root", root, "--status"]);
+    await assertCliError(bin, ["--root", root, "--status", "RESOLVED"]);
+    await assertCliError(bin, ["--root", root, "--has-final-report", "YES"]);
+    await assertCliError(bin, ["--root", root, "--has-final-report", "maybe"]);
+    await assertCliError(bin, ["--root", root, "--offset", "-1"]);
+    await assertCliError(bin, ["--root", root, "--limit", "1.5"]);
+    await assertCliError(bin, ["--root", root, "--offset", "Infinity"]);
+    await assertCliError(bin, ["--root", root, "--limit", "junk"]);
+    await assertCliError(bin, ["--root", root, "--limit", "--status"]);
+    await assertCliError(bin, ["--root", join(base, "missing"), "--limit", "0", "--status", "invalid"]);
+  } finally {
+    await rm(base, { recursive: true, force: true });
+  }
+});
+
+test("catalog CLI skips child and artifact links and leaves all fixture contents unchanged", async () => {
+  const { base, root, bin } = await fixture();
+  async function snapshot(directory: string): Promise<Record<string, unknown>> {
+    const result: Record<string, unknown> = {};
+    for (const child of await readdir(directory, { withFileTypes: true })) {
+      const path = join(directory, child.name);
+      result[child.name] = child.isSymbolicLink() ? { link: await readlink(path) }
+        : child.isDirectory() ? await snapshot(path) : await readFile(path, "utf8");
+    }
+    return result;
+  }
+  try {
+    const outside = join(base, "outside");
+    const debate = join(root, "debate-real");
+    await Promise.all([mkdir(outside), mkdir(debate)]);
+    await writeFile(join(outside, "saved.md"), "STATUS: RESOLVED\nprivate fixture text\n");
+    await Promise.all([
+      symlink(outside, join(root, "debate-linked")),
+      symlink(join(outside, "saved.md"), join(debate, "debate.md")),
+      symlink(join(outside, "saved.md"), join(debate, "final-report.md")),
+      symlink(join(outside, "saved.md"), join(debate, "respondeo.md")),
+    ]);
+    const before = await snapshot(base);
+    const output = await run(bin, "--root", root);
+    assert.deepEqual(JSON.parse(output.stdout), [
+      { id: "debate-real", path: debate, hasTranscript: false, hasFinalReport: false, determination: null, status: "unjudged" },
+    ]);
+    assert.deepEqual(await snapshot(base), before);
+  } finally {
+    await rm(base, { recursive: true, force: true });
+  }
+});
+
+test("catalog CLI artifact mode writes exact artifact bytes without a newline", async () => {
+  const { base, root, bin } = await fixture();
+  try {
+    const debate = join(root, "debate-artifacts");
+    const transcript = "  opening\nλ and \ud83d\ude80";
+    const determination = "\nSTATUS: NEEDS_INPUT\r\n¿qué sigue?";
+    await mkdir(debate);
+    await Promise.all([
+      writeFile(join(debate, "debate.md"), transcript),
+      writeFile(join(debate, "respondeo-2.md"), "STATUS: RESOLVED"),
+      writeFile(join(debate, "respondeo-10.md"), determination),
+      writeFile(join(debate, "final-report.md"), ""),
+    ]);
+
+    const transcriptResult = await run(bin, "--artifact", "transcript", "--root", root, "--id", "debate-artifacts");
+    assert.equal(transcriptResult.stderr, "");
+    assert.equal(transcriptResult.stdout, transcript);
+    const determinationResult = await run(bin, "--id", "debate-artifacts", "--artifact", "determination", "--root", root);
+    assert.equal(determinationResult.stderr, "");
+    assert.equal(determinationResult.stdout, determination);
+    const finalResult = await run(bin, "--root", root, "--artifact", "final-report", "--id", "debate-artifacts");
+    assert.equal(finalResult.stderr, "");
+    assert.equal(finalResult.stdout, "");
+  } finally {
+    await rm(base, { recursive: true, force: true });
+  }
+});
+
+test("catalog CLI artifact mode reports absent valid paths as NOT_FOUND", async () => {
+  const { base, root, bin } = await fixture();
+  try {
+    await mkdir(join(root, "debate-empty"));
+    const artifactArgs = ["--root", root, "--id", "debate-empty", "--artifact", "transcript"];
+    await assertCliError(bin, artifactArgs, "NOT_FOUND", 2);
+    await assertCliError(bin, ["--root", root, "--id", "debate-missing", "--artifact", "final-report"], "NOT_FOUND", 2);
+    await assertCliError(bin, ["--root", join(base, "missing"), "--id", "debate-empty", "--artifact", "determination"], "NOT_FOUND", 2);
+  } finally {
+    await rm(base, { recursive: true, force: true });
+  }
+});
+
+test("catalog CLI artifact mode rejects incomplete, incompatible, and invalid arguments", async () => {
+  const { base, root, bin } = await fixture();
+  try {
+    const required = ["--root", root, "--id", "debate-valid", "--artifact", "transcript"];
+    await assertCliError(bin, ["--root", root, "--id", "debate-valid"]);
+    await assertCliError(bin, ["--root", root, "--artifact", "transcript"]);
+    await assertCliError(bin, ["--id", "debate-valid", "--artifact", "transcript"]);
+    await assertCliError(bin, ["--root", root, "--id", "--artifact", "transcript"]);
+    await assertCliError(bin, ["--root", root, "--id", "debate-valid", "--artifact", "--limit", "0"]);
+    await assertCliError(bin, ["--root", root, "--id", "debate-valid", "--artifact", "report"]);
+    await assertCliError(bin, ["--root", root, "--id", "../debate-valid", "--artifact", "transcript"], "INVALID_ID");
+    for (const [flag, value] of [["--status", "resolved"], ["--has-final-report", "no"], ["--offset", "0"], ["--limit", "0"]]) {
+      await assertCliError(bin, [...required, flag, value]);
+    }
+  } finally {
+    await rm(base, { recursive: true, force: true });
+  }
+});
+
+test("catalog CLI artifact mode rejects directory and artifact links without changing targets", async () => {
+  const { base, root, bin } = await fixture();
+  try {
+    const outside = join(base, "outside");
+    const linkedArtifacts = join(root, "debate-linked-artifacts");
+    const targetDirectory = join(outside, "debate-target");
+    await mkdir(outside);
+    await Promise.all([mkdir(linkedArtifacts), mkdir(targetDirectory)]);
+    await Promise.all([
+      writeFile(join(outside, "saved.md"), "outside contents"),
+      writeFile(join(targetDirectory, "debate.md"), "target transcript"),
+      symlink(targetDirectory, join(root, "debate-child-link")),
+      symlink(join(outside, "saved.md"), join(linkedArtifacts, "debate.md")),
+      symlink(join(outside, "missing.md"), join(linkedArtifacts, "final-report.md")),
+    ]);
+
+    await assertCliError(bin, ["--root", root, "--id", "debate-child-link", "--artifact", "transcript"], "UNSAFE_PATH");
