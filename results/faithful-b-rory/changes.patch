+#!/usr/bin/env node
+// Standalone read-only CLI: importing the debate entry point would launch agents.
+import { listDebates, readDebateArtifact, type DebateArtifactKind, type ListDebatesOptions } from "./catalog.ts";
+
+type CatalogCommand =
+  | { mode: "list"; root: string; options: ListDebatesOptions }
+  | { mode: "artifact"; root: string; id: string; kind: DebateArtifactKind };
+
+function invalidQuery(message: string): Error & { code: string } {
+  return Object.assign(new Error(message), { code: "INVALID_QUERY" });
+}
+
+function parseArguments(args: string[]): CatalogCommand {
+  let root: string | undefined;
+  let id: string | undefined;
+  let artifact: string | undefined;
+  const options: ListDebatesOptions = {};
+  const seen = new Set<string>();
+
+  for (let i = 0; i < args.length; i += 2) {
+    const flag = args[i];
+    if (!["--root", "--status", "--has-final-report", "--offset", "--limit", "--id", "--artifact"].includes(flag)) {
+      throw invalidQuery(`Unknown argument: ${flag}`);
+    }
+    if (seen.has(flag)) throw invalidQuery(`Duplicate flag: ${flag}`);
+    seen.add(flag);
+
+    const value = args[i + 1];
+    if (value === undefined || value === "" || value.startsWith("--")) {
+      throw invalidQuery(`Missing value for ${flag}`);
+    }
+
+    switch (flag) {
+      case "--root":
+        root = value;
+        break;
+      case "--id":
+        id = value;
+        break;
+      case "--artifact":
+        artifact = value;
+        break;
+      case "--status":
+        // listDebates validates the status against the catalog's accepted values.
+        options.status = value as ListDebatesOptions["status"];
+        break;
+      case "--has-final-report":
+        if (value !== "yes" && value !== "no") {
+          throw invalidQuery("--has-final-report must be yes or no");
+        }
+        options.hasFinalReport = value === "yes";
+        break;
+      case "--offset":
+      case "--limit": {
+        const number = Number(value);
+        if (/[^0-9]/.test(value) || !Number.isInteger(number)) {
+          throw invalidQuery(`${flag} must be a nonnegative integer`);
+        }
+        options[flag === "--offset" ? "offset" : "limit"] = number;
+        break;
+      }
+    }
+  }
+
+  if (root === undefined) throw invalidQuery("Missing required --root DIRECTORY");
+  if (id !== undefined || artifact !== undefined) {
+    if (id === undefined || artifact === undefined) {
+      throw invalidQuery("--id and --artifact must be provided together");
+    }
+    if (Object.keys(options).length > 0) {
+      throw invalidQuery("Artifact mode cannot combine with --status, --has-final-report, --offset, or --limit");
+    }
+    // readDebateArtifact validates both the ID and the artifact kind.
+    return { mode: "artifact", root, id, kind: artifact as DebateArtifactKind };
+  }
+  return { mode: "list", root, options };
+}
+
+try {
+  const command = parseArguments(process.argv.slice(2));
+  if (command.mode === "artifact") {
+    const text = await readDebateArtifact(command.root, command.id, command.kind);
+    if (text === null) {
+      console.error(`NOT_FOUND: ${command.kind} artifact for ${command.id} was not found`);
+      process.exitCode = 2;
+    } else {
+      process.stdout.write(text);
+    }
+  } else {
+    const entries = await listDebates(command.root, command.options);
+    console.log(JSON.stringify(entries));
+  }
+} catch (error: unknown) {
+  const code = (error as { code?: string } | null)?.code ?? "CATALOG_ERROR";
+  const message = error instanceof Error ? error.message : String(error);
+  console.error(`${code}: ${message}`);
+  process.exitCode = 1;
+}
