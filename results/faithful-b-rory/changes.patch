+test("readDebateArtifact rejects directory and direct artifact symlinks without reading their targets", async () => {
+  const { base, root, outside } = await fixture();
+  try {
+    const target = join(outside, "debate-target");
+    const artifactLinks = join(root, "debate-artifact-links");
+    await Promise.all([mkdir(target), mkdir(artifactLinks)]);
+    await Promise.all([
+      writeFile(join(target, "debate.md"), "outside transcript"),
+      writeFile(join(outside, "outside-report.md"), "outside report"),
+      writeFile(join(artifactLinks, "internal-report.md"), "internal report"),
+      symlink(target, join(root, "debate-child-link")),
+      symlink(join(outside, "missing"), join(root, "debate-dangling-link")),
+      symlink(join(outside, "outside-report.md"), join(artifactLinks, "debate.md")),
+      symlink(join(artifactLinks, "internal-report.md"), join(artifactLinks, "final-report.md")),
+    ]);
+
+    await assertErrorCode(() => readDebateArtifact(root, "debate-child-link", "transcript"), "UNSAFE_PATH");
+    await assertErrorCode(() => readDebateArtifact(root, "debate-child-link", "determination"), "UNSAFE_PATH");
+    await assertErrorCode(() => readDebateArtifact(root, "debate-dangling-link", "final-report"), "UNSAFE_PATH");
+    await assertErrorCode(() => readDebateArtifact(root, "debate-artifact-links", "transcript"), "UNSAFE_PATH");
+    await assertErrorCode(() => readDebateArtifact(root, "debate-artifact-links", "final-report"), "UNSAFE_PATH");
+    assert.equal(await readFile(join(target, "debate.md"), "utf8"), "outside transcript");
+    assert.equal(await readFile(join(outside, "outside-report.md"), "utf8"), "outside report");
+    assert.equal(await readFile(join(artifactLinks, "internal-report.md"), "utf8"), "internal report");
+    await rm(join(artifactLinks, "final-report.md"));
+    await symlink(join(outside, "missing"), join(artifactLinks, "final-report.md"));
+    await assertErrorCode(() => readDebateArtifact(root, "debate-artifact-links", "final-report"), "UNSAFE_PATH");
+  } finally {
+    await rm(base, { recursive: true, force: true });
+  }
+});
