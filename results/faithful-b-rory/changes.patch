+import { lstat, open, readdir } from "node:fs/promises";
+import { constants, type Dirent } from "node:fs";
+import { join, resolve } from "node:path";
+
+export type DeterminationStatus = "resolved" | "needs-input" | "failed" | "unknown";
+export type DebateArtifactKind = "transcript" | "determination" | "final-report";
+
+export interface DebateEntry {
+  id: string;
+  path: string;
+  hasTranscript: boolean;
+  hasFinalReport: boolean;
+  determination: string | null;
+  status: "unjudged" | DeterminationStatus;
+}
+
+export interface ListDebatesOptions {
+  offset?: number;
+  limit?: number;
+  /** Filters apply to the full catalog before offset and limit. */
+  status?: DebateEntry["status"];
+  hasFinalReport?: boolean;
+}
+
+const DEBATE_DIR = /^debate-[A-Za-z0-9][A-Za-z0-9._-]*$/;
+
+export function classifyDetermination(text: string): DeterminationStatus {
+  const firstLine = text.split(/\r\n|\n|\r/).map((line) => line.trim()).find(Boolean) ?? "";
+  if (firstLine === "STATUS: RESOLVED") return "resolved";
+  if (firstLine === "STATUS: NEEDS_INPUT") return "needs-input";
+  if (firstLine.startsWith("Respondeo turn failed:")) return "failed";
+  return "unknown";
+}
+
+async function determinationCandidates(path: string): Promise<{ name: string; version: bigint }[]> {
+  const candidates: { name: string; version: bigint }[] = [];
+  for (const child of await readdir(path, { withFileTypes: true })) {
+    if (!child.isFile()) continue;
+    const match = /^respondeo(?:-([0-9]+))?\.md$/.exec(child.name);
+    if (!match || match[0] !== child.name) continue;
+    const version = BigInt(match[1] ?? "1");
+    if (version > 0n) candidates.push({ name: child.name, version });
+  }
+  // Numeric versions may exceed Number's precision. Break equal-version ties by
+  // filename so directory enumeration order cannot change the selected artifact.
+  candidates.sort((a, b) => a.version === b.version
+    ? (a.name < b.name ? -1 : a.name > b.name ? 1 : 0)
+    : a.version > b.version ? -1 : 1);
+  return candidates;
+}
+
+function unsafePath(): Error & { code: string } {
+  return Object.assign(new Error("Refusing to follow a catalog symlink"), { code: "UNSAFE_PATH" });
+}
+
+async function readRegularArtifact(path: string, rejectSymlinks: boolean): Promise<string | null> {
+  let file;
+  try {
+    const info = await lstat(path);
+    if (info.isSymbolicLink()) {
+      if (rejectSymlinks) throw unsafePath();
+      return null;
+    }
+    if (!info.isFile()) return null;
+    // Refuse an artifact swapped for a symlink after inspection. Nonblocking open
+    // also avoids hanging if it was replaced with a pipe before the handle check.
+    file = await open(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+  } catch (error: unknown) {
+    const code = (error as NodeJS.ErrnoException).code;
+    if (code === "ENOENT" || code === "ENOTDIR") return null;
+    if (code === "ELOOP") {
+      if (rejectSymlinks) throw unsafePath();
+      return null;
+    }
+    throw error;
+  }
+  try {
+    if (!(await file.stat()).isFile()) return null;
+    return await file.readFile("utf8");
+  } finally {
+    await file.close();
+  }
+}
+
+async function latestDetermination(path: string, rejectSymlinks: boolean): Promise<{ name: string; text: string } | null> {
+  for (const candidate of await determinationCandidates(path)) {
+    const text = await readRegularArtifact(join(path, candidate.name), rejectSymlinks);
+    if (text !== null) return { name: candidate.name, text };
+  }
+  return null;
+}
+
+async function determinationMetadata(path: string): Promise<Pick<DebateEntry, "determination" | "status">> {
+  const selected = await latestDetermination(path, false);
+  return selected
+    ? { determination: selected.name, status: classifyDetermination(selected.text) }
+    : { determination: null, status: "unjudged" };
+}
+
+async function isRegularFile(path: string): Promise<boolean> {
+  try {
+    return (await lstat(path)).isFile();
+  } catch (error: unknown) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return false;
+    throw error;
+  }
+}
+
+/**
+ * Reads an artifact verbatim without following child-directory or artifact links.
+ * Determination selection, as in the catalog, considers only regular files;
+ * a selected file replaced by a symlink is rejected rather than followed.
+ */
+export async function readDebateArtifact(root: string, id: string, kind: DebateArtifactKind): Promise<string | null> {
+  if (typeof id !== "string" || !DEBATE_DIR.test(id)) {
+    throw Object.assign(new Error("id must be a debate directory basename"), { code: "INVALID_ID" });
+  }
+  if (!["transcript", "determination", "final-report"].includes(kind)) {
+    throw Object.assign(new Error("Unknown artifact kind"), { code: "INVALID_QUERY" });
+  }
+
+  const directory = join(resolve(root), id);
+  try {
+    const info = await lstat(directory);
+    if (info.isSymbolicLink()) throw unsafePath();
+    if (!info.isDirectory()) return null;
+
+    if (kind === "determination") {
+      return (await latestDetermination(directory, true))?.text ?? null;
+    }
+    const filename = kind === "transcript" ? "debate.md" : "final-report.md";
+    return await readRegularArtifact(join(directory, filename), true);
+  } catch (error: unknown) {
+    const code = (error as NodeJS.ErrnoException).code;
+    if (code === "ENOENT" || code === "ENOTDIR") return null;
+    throw error;
+  }
+}
+
+/**
+ * Lists the immediate, real debate directories below root in descending ID order,
+ * filtering the full catalog before applying offset and then limit to the matches.
+ * Artifact checks use lstat so links are not represented as transcripts or final reports. Determinations
+ * are read through a read-only handle that refuses artifact symlinks.
+ */
+export async function listDebates(root: string, options: ListDebatesOptions = {}): Promise<DebateEntry[]> {
+  const { offset = 0, limit, status, hasFinalReport } = options;
+  for (const [name, value] of Object.entries({ offset, limit })) {
+    if (value !== undefined && (!Number.isInteger(value) || value < 0)) {
+      throw Object.assign(new Error(`${name} must be a nonnegative integer`), { code: "INVALID_QUERY" });
+    }
+  }
+  if (status !== undefined && !["unjudged", "resolved", "needs-input", "failed", "unknown"].includes(status)) {
+    throw Object.assign(new Error("status must be a catalog status"), { code: "INVALID_QUERY" });
+  }
+  if (hasFinalReport !== undefined && typeof hasFinalReport !== "boolean") {
+    throw Object.assign(new Error("hasFinalReport must be a boolean"), { code: "INVALID_QUERY" });
+  }
+  if (limit === 0) return [];
+
+  const absoluteRoot = resolve(root);
+  let children: Dirent[];
+
+  try {
+    children = await readdir(absoluteRoot, { withFileTypes: true });
+  } catch (error: unknown) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return [];
+    throw error;
+  }
+
+  const directories = children
+    .filter((child) => child.isDirectory() && DEBATE_DIR.test(child.name))
+    .map((child) => child.name)
+    .sort()
+    .reverse();
+
+  const entries = await Promise.all(directories.map(async (id) => {
+    const path = join(absoluteRoot, id);
+    const [hasTranscript, hasFinalReport, metadata] = await Promise.all([
+      isRegularFile(join(path, "debate.md")),
+      isRegularFile(join(path, "final-report.md")),
+      determinationMetadata(path),
+    ]);
+    return { id, path, hasTranscript, hasFinalReport, ...metadata };
+  }));
+
+  // Offset and limit count matching debates, not unfiltered directory positions.
+  return entries.filter((entry) =>
+    (status === undefined || entry.status === status) &&
+    (hasFinalReport === undefined || entry.hasFinalReport === hasFinalReport))
+    .slice(offset)
+    .slice(0, limit);
+}
